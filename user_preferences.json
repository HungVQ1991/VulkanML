{
  "device": {
    "preferred_type": "INTEGRATED_GPU",
    "preferred_device_index": 0
  },
  "execution": {
    "default_execution_target": "VULKAN_GPU",
    "enable_shader_fusion": true,
    "enable_cooperative_matrix": true,
    "max_frames_in_flight": 2,
    "default_precision": "FLOAT32"
  },
  "memory": {
    "staging_pool_initial_size_mb": 64,
    "enable_timeline_semaphore": true,
    "enable_push_descriptor": true
  },
  "logging": {
    "enable_logging": true,
    "level": "LOG_INFO",
    "console_enabled": true,
    "console_level": "LOG_DEBUG",
    "file_enabled": false,
    "file_level": "LOG_DEBUG",
    "log_directory": "logs",
    "color_mode": "auto",
    "quiet_mode": false,
    "errors_to_stderr": false,
    "filter_info_by_feature": false,
    "include_timestamp_ms": false,
    "include_thread_id": false,
    "include_source_location": false,
    "features": [
      "DEVICE_MANAGEMENT",
      "FP16_METRICS",
      "TERNARY_METRICS",
      "SYNCHRONIZATION"
    ]
  }
}
