{
  "device": {
    "preferred_type": "INTEGRATED_GPU",
    "preferred_device_index": 0
  },
  "execution": {
    "default_execution_target": "VULKAN_GPU",
    "enable_shader_fusion": true,
    "enable_cooperative_matrix": true,
    "max_frames_in_flight": 2,
    "default_precision": "FLOAT32"
  },
  "memory": {
    "staging_pool_initial_size_mb": 64,
    "enable_timeline_semaphore": true
  },
  "logging": {
    "enable_logging": true,
    "level": "LOG_INFO",
    "features": [
      "DEVICE_MANAGEMENT",
      "FP16_METRICS",
      "SYNCHRONIZATION"
    ]
  }
}
