#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputX { float X[]; };
layout(std430, binding = 1) writeonly buffer OutputY { float Y[]; };
layout(std430, binding = 2) readonly buffer Gamma { float gamma[]; };
layout(std430, binding = 3) readonly buffer Beta { float beta[]; };
layout(std430, binding = 4) readonly buffer Mean { float mean[]; };
layout(std430, binding = 5) readonly buffer Var { float variance[]; };
layout(std430, binding = 6) writeonly buffer XHat { float x_hat[]; };

layout(push_constant) uniform PushConstants {
    uint total_elements;
    uint channels;
    float epsilon;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total_elements) return;

    uint c = idx % pc.channels;

    float m = mean[c];
    float v = variance[c];
    float g = gamma[c];
    float b = beta[c];

    float norm = (X[idx] - m) / sqrt(v + pc.epsilon);
    x_hat[idx] = norm;
    Y[idx] = g * norm + b;
}