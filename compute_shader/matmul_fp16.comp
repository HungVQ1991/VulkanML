#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

#define TILE_SIZE 16

layout(local_size_x = TILE_SIZE, local_size_y = TILE_SIZE, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Matrix_A { float16_t data_a[]; };
layout(std430, binding = 1) readonly buffer Matrix_B { float16_t data_b[]; };
layout(std430, binding = 2) writeonly buffer Matrix_C { float16_t data_c[]; };

layout(push_constant) uniform Matrix_Dimensions {
    uint batch_count;
    uint rows_a;
    uint cols_a;
    uint cols_b;
    uint broadcast_b;
} dims;

shared float16_t tile_a[TILE_SIZE][TILE_SIZE];
shared float16_t tile_b[TILE_SIZE][TILE_SIZE];

void main() {
    uint col = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    uint batch = gl_GlobalInvocationID.z;
    
    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    if (batch >= dims.batch_count) return;

    float sum = 0.0;
    uint num_tiles = (dims.cols_a + TILE_SIZE - 1) / TILE_SIZE;

    uint a_batch_offset = batch * dims.rows_a * dims.cols_a;
    uint b_batch_offset = (dims.broadcast_b == 1) ? 0 : (batch * dims.cols_a * dims.cols_b);

    for (uint t = 0; t < num_tiles; ++t) {
        uint tiled_col_a = t * TILE_SIZE + local_col;
        if (row < dims.rows_a && tiled_col_a < dims.cols_a) {
            tile_a[local_row][local_col] = data_a[a_batch_offset + row * dims.cols_a + tiled_col_a];
        } else {
            tile_a[local_row][local_col] = float16_t(0.0);
        }

        uint tiled_row_b = t * TILE_SIZE + local_row;
        if (tiled_row_b < dims.cols_a && col < dims.cols_b) {
            tile_b[local_row][local_col] = data_b[b_batch_offset + tiled_row_b * dims.cols_b + col];
        } else {
            tile_b[local_row][local_col] = float16_t(0.0);
        }

        barrier();

        #pragma unroll
        for (uint k = 0; k < TILE_SIZE; ++k) {
            sum += float(tile_a[local_row][k]) * float(tile_b[k][local_col]);
        }

        barrier();
    }

    if (row < dims.rows_a && col < dims.cols_b) {
        data_c[batch * dims.rows_a * dims.cols_b + row * dims.cols_b + col] = float16_t(sum);
    }
}
