#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Input_Buffer { float input_data[]; };
layout(set = 0, binding = 1) readonly buffer Weight_Buffer { float weight_data[]; };
layout(set = 0, binding = 2) readonly buffer Bias_Buffer { float bias_data[]; };
layout(set = 0, binding = 3) writeonly buffer Output_Buffer { float output_data[]; };

layout(push_constant) uniform Push_Constants {
    uint batch_size;
    uint in_h;
    uint in_w;
    uint in_c;
    uint out_h;
    uint out_w;
    uint out_c;
    uint kernel_size;
    uint stride;
    uint padding;
} params;

void main() {
    uint out_c_idx = gl_GlobalInvocationID.x;
    uint out_w_idx = gl_GlobalInvocationID.y;
    uint n_out_h_idx = gl_GlobalInvocationID.z;

    if (out_c_idx >= params.out_c || out_w_idx >= params.out_w || n_out_h_idx >= params.batch_size * params.out_h) {
        return;
    }

    uint n_idx = n_out_h_idx / params.out_h;
    uint out_h_idx = n_out_h_idx % params.out_h;

    float sum = bias_data[out_c_idx];

    for (uint ky = 0; ky < params.kernel_size; ky++) {
        for (uint kx = 0; kx < params.kernel_size; kx++) {
            int in_y = int(out_h_idx * params.stride + ky) - int(params.padding);
            int in_x = int(out_w_idx * params.stride + kx) - int(params.padding);

            if (in_y >= 0 && in_y < int(params.in_h) && in_x >= 0 && in_x < int(params.in_w)) {
                for (uint in_c_idx = 0; in_c_idx < params.in_c; in_c_idx++) {
                    uint in_idx = n_idx * params.in_h * params.in_w * params.in_c +
                                  uint(in_y) * params.in_w * params.in_c +
                                  uint(in_x) * params.in_c +
                                  in_c_idx;
                    
                    uint w_idx = ky * params.kernel_size * params.in_c * params.out_c +
                                 kx * params.in_c * params.out_c +
                                 in_c_idx * params.out_c +
                                 out_c_idx;
                    
                    sum += input_data[in_idx] * weight_data[w_idx];
                }
            }
        }
    }

    uint out_idx = n_idx * params.out_h * params.out_w * params.out_c +
                   out_h_idx * params.out_w * params.out_c +
                   out_w_idx * params.out_c +
                   out_c_idx;
    
    output_data[out_idx] = sum;
}