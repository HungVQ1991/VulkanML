#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Input_Buffer { float input_data[]; };
layout(set = 0, binding = 1) writeonly buffer Output_Buffer { float output_data[]; };
layout(set = 0, binding = 2) writeonly buffer Mask_Buffer { uint mask_data[]; };

layout(push_constant) uniform Push_Constants {
    uint batch_size;
    uint in_h;
    uint in_w;
    uint channels;
    uint out_h;
    uint out_w;
    uint kernel_size;
    uint stride;
    uint padding;
} params;

void main() {
    uint c_idx = gl_GlobalInvocationID.x;
    uint out_w_idx = gl_GlobalInvocationID.y;
    uint n_out_h_idx = gl_GlobalInvocationID.z;

    if (c_idx >= params.channels || out_w_idx >= params.out_w || n_out_h_idx >= params.batch_size * params.out_h) {
        return;
    }

    uint n_idx = n_out_h_idx / params.out_h;
    uint out_h_idx = n_out_h_idx % params.out_h;

    float max_val = -3.402823466e+38;
    uint max_idx = 0;

    for (uint ky = 0; ky < params.kernel_size; ky++) {
        for (uint kx = 0; kx < params.kernel_size; kx++) {
            int in_y = int(out_h_idx * params.stride + ky) - int(params.padding);
            int in_x = int(out_w_idx * params.stride + kx) - int(params.padding);

            if (in_y >= 0 && in_y < int(params.in_h) && in_x >= 0 && in_x < int(params.in_w)) {
                uint in_idx = n_idx * params.in_h * params.in_w * params.channels +
                              uint(in_y) * params.in_w * params.channels +
                              uint(in_x) * params.channels +
                              c_idx;
                
                float val = input_data[in_idx];
                if (val > max_val) {
                    max_val = val;
                    max_idx = in_idx;
                }
            }
        }
    }

    uint out_idx = n_idx * params.out_h * params.out_w * params.channels +
                   out_h_idx * params.out_w * params.channels +
                   out_w_idx * params.channels +
                   c_idx;
                   
    output_data[out_idx] = max_val;
    mask_data[out_idx] = max_idx;
}