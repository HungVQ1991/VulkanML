#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Grad_Output_Buffer { float grad_output[]; };
layout(set = 0, binding = 1) readonly buffer Weight_Buffer { float weight_data[]; };
layout(set = 0, binding = 2) writeonly buffer Grad_Input_Buffer { float grad_input[]; };

layout(push_constant) uniform Push_Constants {
    uint batch_size;
    uint in_h;
    uint in_w;
    uint in_c;
    uint out_h;
    uint out_w;
    uint out_c;
    uint kernel_size;
    uint stride;
    uint padding;
} params;

void main() {
    uint in_c_idx = gl_GlobalInvocationID.x;
    uint in_w_idx = gl_GlobalInvocationID.y;
    uint n_in_h_idx = gl_GlobalInvocationID.z;

    if (in_c_idx >= params.in_c || in_w_idx >= params.in_w || n_in_h_idx >= params.batch_size * params.in_h) {
        return;
    }

    uint n_idx = n_in_h_idx / params.in_h;
    uint in_h_idx = n_in_h_idx % params.in_h;

    float sum = 0.0;

    for (uint ky = 0; ky < params.kernel_size; ky++) {
        for (uint kx = 0; kx < params.kernel_size; kx++) {
            int out_y_calc = int(in_h_idx + params.padding - ky);
            int out_x_calc = int(in_w_idx + params.padding - kx);

            if (out_y_calc >= 0 && out_y_calc % int(params.stride) == 0 &&
                out_x_calc >= 0 && out_x_calc % int(params.stride) == 0) {
                
                uint out_y = uint(out_y_calc) / params.stride;
                uint out_x = uint(out_x_calc) / params.stride;

                if (out_y < params.out_h && out_x < params.out_w) {
                    for (uint out_c_idx = 0; out_c_idx < params.out_c; out_c_idx++) {
                        uint grad_out_idx = n_idx * params.out_h * params.out_w * params.out_c +
                                            out_y * params.out_w * params.out_c +
                                            out_x * params.out_c +
                                            out_c_idx;

                        uint w_idx = ky * params.kernel_size * params.in_c * params.out_c +
                                     kx * params.in_c * params.out_c +
                                     in_c_idx * params.out_c +
                                     out_c_idx;

                        sum += grad_output[grad_out_idx] * weight_data[w_idx];
                    }
                }
            }
        }
    }

    uint in_idx = n_idx * params.in_h * params.in_w * params.in_c +
                  in_h_idx * params.in_w * params.in_c +
                  in_w_idx * params.in_c +
                  in_c_idx;

    grad_input[in_idx] = sum;
}