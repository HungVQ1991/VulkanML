#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Input_Buffer { float16_t input_data[]; };
layout(set = 0, binding = 1) readonly buffer Grad_Output_Buffer { float16_t grad_output[]; };
layout(set = 0, binding = 2) writeonly buffer Grad_Weight_Buffer { float grad_weight[]; };
layout(set = 0, binding = 3) writeonly buffer Grad_Bias_Buffer { float grad_bias[]; };

layout(push_constant) uniform Push_Constants {
    uint batch_size;
    uint in_h;
    uint in_w;
    uint in_c;
    uint out_h;
    uint out_w;
    uint out_c;
    uint kernel_size;
    uint stride;
    uint padding;
} params;

void main() {
    uint out_c_idx = gl_GlobalInvocationID.x;
    uint in_c_idx = gl_GlobalInvocationID.y;
    uint ky_kx_idx = gl_GlobalInvocationID.z;

    if (out_c_idx >= params.out_c || in_c_idx >= params.in_c || ky_kx_idx >= params.kernel_size * params.kernel_size) {
        return;
    }

    uint ky = ky_kx_idx / params.kernel_size;
    uint kx = ky_kx_idx % params.kernel_size;

    float weight_sum = 0.0;
    float bias_sum = 0.0; 

    bool is_bias_thread = (in_c_idx == 0 && ky_kx_idx == 0);

    uint out_spatial = params.out_h * params.out_w;
    uint in_spatial = params.in_h * params.in_w;
    uint out_batch_stride = out_spatial * params.out_c;
    uint in_batch_stride = in_spatial * params.in_c;
    uint out_row_stride = params.out_w * params.out_c;
    uint in_row_stride = params.in_w * params.in_c;

    if (params.stride == 1) {
        int min_out_y = clamp(int(params.padding) - int(ky), 0, int(params.out_h));
        int max_out_y = clamp(int(params.in_h + params.padding - ky), 0, int(params.out_h));
        int min_out_x = clamp(int(params.padding) - int(kx), 0, int(params.out_w));
        int max_out_x = clamp(int(params.in_w + params.padding - kx), 0, int(params.out_w));

        for (uint n_idx = 0; n_idx < params.batch_size; n_idx++) {
            uint n_out_base = n_idx * out_batch_stride + out_c_idx;
            uint n_in_base = n_idx * in_batch_stride + in_c_idx;

            // Top out-of-bounds rows
            if (is_bias_thread) {
                for (int out_y = 0; out_y < min_out_y; out_y++) {
                    uint go_ptr = n_out_base + uint(out_y) * out_row_stride;
                    for (uint out_x = 0; out_x < params.out_w; out_x++) {
                        bias_sum += float(grad_output[go_ptr + out_x * params.out_c]);
                    }
                }
            }

            // Valid y rows
            for (int out_y = min_out_y; out_y < max_out_y; out_y++) {
                uint out_y_base = n_out_base + uint(out_y) * out_row_stride;
                int in_y = out_y + int(ky) - int(params.padding);
                uint in_y_base = n_in_base + uint(in_y) * in_row_stride;

                // Left out-of-bounds cols
                if (is_bias_thread) {
                    for (int out_x = 0; out_x < min_out_x; out_x++) {
                        bias_sum += float(grad_output[out_y_base + uint(out_x) * params.out_c]);
                    }
                }

                // Core valid region (both x and y in bounds)
                uint go_ptr = out_y_base + uint(min_out_x) * params.out_c;
                int in_x_start = min_out_x + int(kx) - int(params.padding);
                uint in_ptr = in_y_base + uint(in_x_start) * params.in_c;

                for (int out_x = min_out_x; out_x < max_out_x; out_x++) {
                    float go_val = float(grad_output[go_ptr]);
                    float in_val = float(input_data[in_ptr]);
                    weight_sum += in_val * go_val;
                    if (is_bias_thread) {
                        bias_sum += go_val;
                    }
                    go_ptr += params.out_c;
                    in_ptr += params.in_c;
                }

                // Right out-of-bounds cols
                if (is_bias_thread) {
                    for (int out_x = max_out_x; out_x < int(params.out_w); out_x++) {
                        bias_sum += float(grad_output[out_y_base + uint(out_x) * params.out_c]);
                    }
                }
            }

            // Bottom out-of-bounds rows
            if (is_bias_thread) {
                for (int out_y = max_out_y; out_y < int(params.out_h); out_y++) {
                    uint go_ptr = n_out_base + uint(out_y) * out_row_stride;
                    for (uint out_x = 0; out_x < params.out_w; out_x++) {
                        bias_sum += float(grad_output[go_ptr + out_x * params.out_c]);
                    }
                }
            }
        }
    } else {
        // Fallback for general stride
        for (uint n_idx = 0; n_idx < params.batch_size; n_idx++) {
            uint n_out_base = n_idx * out_batch_stride + out_c_idx;
            uint n_in_base = n_idx * in_batch_stride + in_c_idx;

            for (uint out_y = 0; out_y < params.out_h; out_y++) {
                uint out_y_base = n_out_base + out_y * out_row_stride;
                int in_y = int(out_y * params.stride + ky) - int(params.padding);
                bool valid_y = (in_y >= 0 && in_y < int(params.in_h));
                uint in_y_base = n_in_base + (valid_y ? uint(in_y) * in_row_stride : 0u);

                for (uint out_x = 0; out_x < params.out_w; out_x++) {
                    uint go_ptr = out_y_base + out_x * params.out_c;
                    float go_val = float(grad_output[go_ptr]);

                    if (is_bias_thread) {
                        bias_sum += go_val;
                    }

                    if (valid_y) {
                        int in_x = int(out_x * params.stride + kx) - int(params.padding);
                        if (in_x >= 0 && in_x < int(params.in_w)) {
                            uint in_ptr = in_y_base + uint(in_x) * params.in_c;
                            weight_sum += float(input_data[in_ptr]) * go_val;
                        }
                    }
                }
            }
        }
    }

    uint w_idx = ky * params.kernel_size * params.in_c * params.out_c +
                 kx * params.in_c * params.out_c +
                 in_c_idx * params.out_c +
                 out_c_idx;
                 
    grad_weight[w_idx] = weight_sum;

    if (is_bias_thread) {
        grad_bias[out_c_idx] = bias_sum;
    }
}
