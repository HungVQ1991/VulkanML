#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Input_Predictions {
    float predictions[];
};

layout(std430, binding = 1) readonly buffer Input_Targets {
    float targets[];
};

layout(std430, binding = 2) writeonly buffer Output_Loss {
    float loss[];
};

layout(push_constant) uniform PushConstants {
    uint total_elements;
    float delta;
} pc;

shared float shared_cache[256];

void main() {
    uint local_id = gl_LocalInvocationID.x;
    uint global_id = gl_GlobalInvocationID.x;

    float element_loss = 0.0;
    if (global_id < pc.total_elements) {
        float difference = predictions[global_id] - targets[global_id];
        float abs_difference = abs(difference);
        if (abs_difference <= pc.delta) {
            element_loss = 0.5 * difference * difference;
        } else {
            element_loss = pc.delta * (abs_difference - 0.5 * pc.delta);
        }
    }

    shared_cache[local_id] = element_loss;
    barrier();

    for (uint stride = gl_WorkGroupSize.x / 2; stride > 0; stride >>= 1) {
        if (local_id < stride) {
            shared_cache[local_id] += shared_cache[local_id + stride];
        }
        barrier();
    }

    if (local_id == 0) {
        loss[gl_WorkGroupID.x] = shared_cache[0];
    }
}