#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Grad_Output_Buffer { float grad_output[]; };
layout(set = 0, binding = 1) writeonly buffer Grad_Input_Buffer { float grad_input[]; };

layout(push_constant) uniform Push_Constants {
    uint batch_size;
    uint in_h;
    uint in_w;
    uint channels;
} params;

void main() {
    uint c_idx = gl_GlobalInvocationID.x;
    uint w_idx = gl_GlobalInvocationID.y;
    uint n_h_idx = gl_GlobalInvocationID.z;

    if (c_idx >= params.channels || w_idx >= params.in_w || n_h_idx >= params.batch_size * params.in_h) {
        return;
    }

    uint n_idx = n_h_idx / params.in_h;
    uint h_idx = n_h_idx % params.in_h;

    uint out_idx = n_idx * params.channels + c_idx;
    
    float grad = grad_output[out_idx] / float(params.in_h * params.in_w);

    uint in_idx = n_idx * params.in_h * params.in_w * params.channels +
                  h_idx * params.in_w * params.channels +
                  w_idx * params.channels +
                  c_idx;

    grad_input[in_idx] = grad;
}