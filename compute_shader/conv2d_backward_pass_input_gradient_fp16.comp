#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Grad_Output_Buffer { float16_t grad_output[]; };
layout(set = 0, binding = 1) readonly buffer Weight_Buffer { float16_t weight_data[]; };
layout(set = 0, binding = 2) writeonly buffer Grad_Input_Buffer { float16_t grad_input[]; };

layout(push_constant) uniform Push_Constants {
    uint batch_size;
    uint in_h;
    uint in_w;
    uint in_c;
    uint out_h;
    uint out_w;
    uint out_c;
    uint kernel_size;
    uint stride;
    uint padding;
} params;

void main() {
    uint in_c_idx = gl_GlobalInvocationID.x;
    uint in_w_idx = gl_GlobalInvocationID.y;
    uint n_in_h_idx = gl_GlobalInvocationID.z;

    if (in_c_idx >= params.in_c || in_w_idx >= params.in_w || n_in_h_idx >= params.batch_size * params.in_h) {
        return;
    }

    uint n_idx = n_in_h_idx / params.in_h;
    uint in_h_idx = n_in_h_idx % params.in_h;

    float sum = 0.0;

    uint out_row_stride = params.out_w * params.out_c;
    uint out_batch_stride = params.out_h * out_row_stride;
    uint n_out_base = n_idx * out_batch_stride;
    uint w_kc_stride = params.in_c * params.out_c;

    for (uint ky = 0; ky < params.kernel_size; ky++) {
        int out_y_calc = int(in_h_idx + params.padding - ky);
        if (out_y_calc < 0 || out_y_calc % int(params.stride) != 0) {
            continue;
        }
        uint out_y = uint(out_y_calc) / params.stride;
        if (out_y >= params.out_h) {
            continue;
        }

        uint out_y_base = n_out_base + out_y * out_row_stride;
        uint ky_w_base = ky * params.kernel_size * w_kc_stride + in_c_idx * params.out_c;

        for (uint kx = 0; kx < params.kernel_size; kx++) {
            int out_x_calc = int(in_w_idx + params.padding - kx);
            if (out_x_calc < 0 || out_x_calc % int(params.stride) != 0) {
                continue;
            }
            uint out_x = uint(out_x_calc) / params.stride;
            if (out_x >= params.out_w) {
                continue;
            }

            uint grad_out_idx = out_y_base + out_x * params.out_c;
            uint w_idx = ky_w_base + kx * w_kc_stride;

            for (uint out_c_idx = 0; out_c_idx < params.out_c; out_c_idx++) {
                sum += float(grad_output[grad_out_idx + out_c_idx]) * float(weight_data[w_idx + out_c_idx]);
            }
        }
    }

    uint in_row_stride = params.in_w * params.in_c;
    uint in_batch_stride = params.in_h * in_row_stride;
    uint in_idx = n_idx * in_batch_stride +
                  in_h_idx * in_row_stride +
                  in_w_idx * params.in_c +
                  in_c_idx;

    grad_input[in_idx] = float16_t(sum);
}
