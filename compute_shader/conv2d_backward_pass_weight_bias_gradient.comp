#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Input_Buffer { float input_data[]; };
layout(set = 0, binding = 1) readonly buffer Grad_Output_Buffer { float grad_output[]; };
layout(set = 0, binding = 2) writeonly buffer Grad_Weight_Buffer { float grad_weight[]; };
layout(set = 0, binding = 3) writeonly buffer Grad_Bias_Buffer { float grad_bias[]; };

layout(push_constant) uniform Push_Constants {
    uint batch_size;
    uint in_h;
    uint in_w;
    uint in_c;
    uint out_h;
    uint out_w;
    uint out_c;
    uint kernel_size;
    uint stride;
    uint padding;
} params;

void main() {
    uint out_c_idx = gl_GlobalInvocationID.x;
    uint in_c_idx = gl_GlobalInvocationID.y;
    uint ky_kx_idx = gl_GlobalInvocationID.z;

    if (out_c_idx >= params.out_c || in_c_idx >= params.in_c || ky_kx_idx >= params.kernel_size * params.kernel_size) {
        return;
    }

    uint ky = ky_kx_idx / params.kernel_size;
    uint kx = ky_kx_idx % params.kernel_size;

    float weight_sum = 0.0;
    float bias_sum = 0.0; 

    for (uint n_idx = 0; n_idx < params.batch_size; n_idx++) {
        for (uint out_y = 0; out_y < params.out_h; out_y++) {
            for (uint out_x = 0; out_x < params.out_w; out_x++) {
                
                uint grad_out_idx = n_idx * params.out_h * params.out_w * params.out_c +
                                    out_y * params.out_w * params.out_c +
                                    out_x * params.out_c +
                                    out_c_idx;
                
                float grad_out_val = grad_output[grad_out_idx];

                if (in_c_idx == 0 && ky_kx_idx == 0) {
                    bias_sum += grad_out_val;
                }

                int in_y = int(out_y * params.stride + ky) - int(params.padding);
                int in_x = int(out_x * params.stride + kx) - int(params.padding);

                if (in_y >= 0 && in_y < int(params.in_h) && in_x >= 0 && in_x < int(params.in_w)) {
                    uint in_idx = n_idx * params.in_h * params.in_w * params.in_c +
                                  uint(in_y) * params.in_w * params.in_c +
                                  uint(in_x) * params.in_c +
                                  in_c_idx;
                    
                    weight_sum += input_data[in_idx] * grad_out_val;
                }
            }
        }
    }

    uint w_idx = ky * params.kernel_size * params.in_c * params.out_c +
                 kx * params.in_c * params.out_c +
                 in_c_idx * params.out_c +
                 out_c_idx;
                 
    grad_weight[w_idx] = weight_sum;

    if (in_c_idx == 0 && ky_kx_idx == 0) {
        grad_bias[out_c_idx] = bias_sum;
    }
}