#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

#define TILE_SIZE 16

layout(local_size_x = TILE_SIZE, local_size_y = TILE_SIZE, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Matrix_A { float16_t data_a[]; };
layout(std430, set = 0, binding = 1) readonly buffer Matrix_B { float16_t data_b[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Matrix_C { float data_c[]; };

layout(push_constant) uniform Matrix_Dimensions {
    uint batch_count;
    uint rows_a;
    uint cols_a;
    uint cols_b;
    uint broadcast_b;
} dims;

shared float16_t tile_a[TILE_SIZE][TILE_SIZE];
shared float16_t tile_b[TILE_SIZE][TILE_SIZE];

void main() {
    uint col = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;

    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    float sum = 0.0;
    uint num_tiles = (dims.cols_a + TILE_SIZE - 1) / TILE_SIZE;

    for (uint t = 0; t < num_tiles; ++t) {
        uint tiled_col_a = t * TILE_SIZE + local_col;
        if (row < dims.rows_a && tiled_col_a < dims.cols_a) {
            tile_a[local_row][local_col] = data_a[row * dims.cols_a + tiled_col_a];
        } else {
            tile_a[local_row][local_col] = float16_t(0.0);
        }

        uint tiled_row_b = t * TILE_SIZE + local_row;
        if (tiled_row_b < dims.cols_a && col < dims.cols_b) {
            tile_b[local_row][local_col] = data_b[tiled_row_b * dims.cols_b + col];
        } else {
            tile_b[local_row][local_col] = float16_t(0.0);
        }

        barrier();

        #pragma unroll
        for (uint k = 0; k < TILE_SIZE; ++k) {
            sum += float(tile_a[local_row][k]) * float(tile_b[k][local_col]);
        }

        barrier();
    }

    if (row < dims.rows_a && col < dims.cols_b) {
        data_c[row * dims.cols_b + col] = sum;
    }
}
