#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer WeightsBuffer {
    float weights[];
};

layout(set = 0, binding = 1) buffer GradsBuffer {
    float grads[];
};

layout(push_constant) uniform PushConstants {
    uint total_elements;
    float learning_rate;
    float max_gradient;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx < params.total_elements) {
        float g = grads[idx];
        if (params.max_gradient > 0.0f) {
            g = clamp(g, -params.max_gradient, params.max_gradient);
        }
        weights[idx] -= params.learning_rate * g;
    }
}