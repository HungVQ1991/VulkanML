#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer GradOutBuffer { float16_t grad_out[]; };
layout(std430, binding = 1) readonly buffer InBuffer { float16_t in_data[]; };
layout(std430, binding = 2) readonly buffer InvRmsBuffer { float inv_rms_data[]; };
layout(std430, binding = 3) buffer GradGammaBuffer { float grad_gamma[]; };

layout(push_constant) uniform Constants {
    uint batch_size;
    uint dim;
    uint accumulate;
} pcs;

void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= pcs.dim) return;

    float sum = 0.0;
    for (uint r = 0; r < pcs.batch_size; ++r) {
        float dy = float(grad_out[r * pcs.dim + c]);
        float x = float(in_data[r * pcs.dim + c]);
        float inv_rms = inv_rms_data[r];
        if (isnan(dy) || isinf(dy)) dy = 0.0;
        if (isnan(x) || isinf(x)) x = 0.0;
        if (isnan(inv_rms) || isinf(inv_rms)) inv_rms = 0.0;
        float term = dy * (x * inv_rms);
        if (!isnan(term) && !isinf(term)) {
            sum += term;
        }
    }

    if (isnan(sum) || isinf(sum)) sum = 0.0;

    if (pcs.accumulate != 0) {
        grad_gamma[c] += sum;
    } else {
        grad_gamma[c] = sum;
    }
}
