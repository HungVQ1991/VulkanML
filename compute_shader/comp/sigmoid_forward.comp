#version 450
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer InputBuffer {
#ifdef USE_FP16
    float16_t X[];
#else
    float X[];
#endif
};

layout(std430, set = 0, binding = 1) writeonly restrict buffer OutputBuffer {
#ifdef USE_FP16
    float16_t Y[];
#else
    float Y[];
#endif
};

layout(push_constant) uniform PushConstants {
    uint total_elements;
} pc;

void main() {
    uint idx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (idx >= pc.total_elements) return;

#ifdef USE_FP16
    float x = float(X[idx]);
    float s = 1.0f / (1.0f + exp(-clamp(x, -85.0f, 85.0f)));
    Y[idx] = float16_t(s);
#else
    float x = X[idx];
    Y[idx] = 1.0f / (1.0f + exp(-clamp(x, -85.0f, 85.0f)));
#endif
}
