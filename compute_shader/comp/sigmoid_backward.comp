#version 450
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer OutputBuffer {
#ifdef USE_FP16
    float16_t Y[];
#else
    float Y[];
#endif
};

layout(std430, set = 0, binding = 1) readonly restrict buffer GradOutputBuffer {
#ifdef USE_FP16
    float16_t dY[];
#else
    float dY[];
#endif
};

layout(std430, set = 0, binding = 2) writeonly restrict buffer GradInputBuffer {
#ifdef USE_FP16
    float16_t dX[];
#else
    float dX[];
#endif
};

layout(push_constant) uniform PushConstants {
    uint total_elements;
} pc;

void main() {
    uint idx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (idx >= pc.total_elements) return;

#ifdef USE_FP16
    float y = float(Y[idx]);
    float dy = float(dY[idx]);
#else
    float y = Y[idx];
    float dy = dY[idx];
#endif
    float grad = dy * y * (1.0f - y);
    if (isnan(grad) || isinf(grad)) {
        grad = 0.0f;
    } else {
#ifdef USE_FP16
        grad = clamp(grad, -65504.0f, 65504.0f);
#else
        grad = clamp(grad, -1e6f, 1e6f);
#endif
    }
#ifdef USE_FP16
    dX[idx] = float16_t(grad);
#else
    dX[idx] = grad;
#endif
}
