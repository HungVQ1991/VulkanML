#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer IndicesBuffer { float indices_data[]; };
layout(std430, binding = 1) readonly buffer GradOutBuffer { float grad_out_data[]; };
layout(std430, binding = 2) buffer WeightGradBuffer { uint weight_grad_raw[]; };

layout(push_constant) uniform Constants {
    uint num_tokens;
    uint embedding_dim;
    uint vocab_size;
} pc;

void atomicAddFloat(uint offset, float val) {
    uint old_val = weight_grad_raw[offset];
    while (true) {
        float old_float = uintBitsToFloat(old_val);
        float new_float = old_float + val;
        uint new_val = floatBitsToUint(new_float);
        uint prev_val = atomicCompSwap(weight_grad_raw[offset], old_val, new_val);
        if (prev_val == old_val) break;
        old_val = prev_val;
    }
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint total = pc.num_tokens * pc.embedding_dim;
    if (gid >= total) return;

    uint token_idx = gid / pc.embedding_dim;
    uint dim_idx = gid % pc.embedding_dim;

    int row = int(round(indices_data[token_idx]));
    if (row >= 0 && uint(row) < pc.vocab_size) {
        uint target_idx = uint(row) * pc.embedding_dim + dim_idx;
        float val = grad_out_data[gid];
        atomicAddFloat(target_idx, val);
    }
}
