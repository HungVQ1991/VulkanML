#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InBuffer { float in_data[]; };
layout(std430, binding = 1) readonly buffer GammaBuffer { float gamma_data[]; };
layout(std430, binding = 2) writeonly buffer OutBuffer { float out_data[]; };
layout(std430, binding = 3) writeonly buffer InvRmsBuffer { float inv_rms_data[]; };

layout(push_constant) uniform Constants {
    uint batch_size;
    uint dim;
    float epsilon;
} pcs;

shared float s_wave_sums[16];

float blockReduceSum(float val) {
    val = subgroupAdd(val);
    if (gl_SubgroupInvocationID == 0u) {
        s_wave_sums[gl_SubgroupID] = val;
    }
    barrier();
    float total = 0.0;
    for (uint i = 0u; i < gl_NumSubgroups; ++i) {
        total += s_wave_sums[i];
    }
    return total;
}

void main() {
    if (pcs.dim == 0u || pcs.batch_size == 0u) return;
    uint row = gl_WorkGroupID.x;
    if (row >= pcs.batch_size) return;

    uint lid = gl_LocalInvocationID.x;
    uint dim = pcs.dim;
    uint row_offset = row * dim;

    if (dim <= 256u) {
        float x0 = 0.0, x1 = 0.0, x2 = 0.0, x3 = 0.0;
        float g0 = 0.0, g1 = 0.0, g2 = 0.0, g3 = 0.0;
        float sum_sq = 0.0;

        uint c0 = lid;
        uint c1 = lid + 64u;
        uint c2 = lid + 128u;
        uint c3 = lid + 192u;

        if (c0 < dim) {
            x0 = in_data[row_offset + c0];
            g0 = gamma_data[c0];
            sum_sq = fma(x0, x0, sum_sq);
        }
        if (c1 < dim) {
            x1 = in_data[row_offset + c1];
            g1 = gamma_data[c1];
            sum_sq = fma(x1, x1, sum_sq);
        }
        if (c2 < dim) {
            x2 = in_data[row_offset + c2];
            g2 = gamma_data[c2];
            sum_sq = fma(x2, x2, sum_sq);
        }
        if (c3 < dim) {
            x3 = in_data[row_offset + c3];
            g3 = gamma_data[c3];
            sum_sq = fma(x3, x3, sum_sq);
        }

        float mean_sq = blockReduceSum(sum_sq) / float(dim);
        float inv_rms = inversesqrt(mean_sq + pcs.epsilon);
        if (lid == 0u) {
            inv_rms_data[row] = inv_rms;
        }

        if (c0 < dim) {
            out_data[row_offset + c0] = x0 * inv_rms * g0;
        }
        if (c1 < dim) {
            out_data[row_offset + c1] = x1 * inv_rms * g1;
        }
        if (c2 < dim) {
            out_data[row_offset + c2] = x2 * inv_rms * g2;
        }
        if (c3 < dim) {
            out_data[row_offset + c3] = x3 * inv_rms * g3;
        }
    } else {
        float sum_sq = 0.0;
        for (uint c = lid; c < dim; c += 64u) {
            float val = in_data[row_offset + c];
            sum_sq = fma(val, val, sum_sq);
        }

        float mean_sq = blockReduceSum(sum_sq) / float(dim);
        float inv_rms = inversesqrt(mean_sq + pcs.epsilon);
        if (lid == 0u) {
            inv_rms_data[row] = inv_rms;
        }

        for (uint c = lid; c < dim; c += 64u) {
            float val = in_data[row_offset + c];
            float g = gamma_data[c];
            out_data[row_offset + c] = val * inv_rms * g;
        }
    }
}
