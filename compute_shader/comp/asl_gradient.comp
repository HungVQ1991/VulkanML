#version 450
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Pred_Buffer {
#ifdef USE_FP16
    float16_t pred_data[];
#else
    float pred_data[];
#endif
};

layout(std430, set = 0, binding = 1) readonly buffer Target_Buffer {
#ifdef USE_FP16
    float16_t target_data[];
#else
    float target_data[];
#endif
};

layout(std430, set = 0, binding = 2) writeonly buffer Grad_Buffer {
#ifdef USE_FP16
    float16_t grad_data[];
#else
    float grad_data[];
#endif
};

layout(push_constant) uniform Push_Constants {
    uint total_elements;
    float gamma_pos;
    float gamma_neg;
    float clip_margin;
    float epsilon_val;
    float inv_total_elements;
} push_constants;

void main() {
    uint wg_id = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint global_idx = wg_id * 256u + gl_LocalInvocationID.x;
    if (global_idx >= push_constants.total_elements) return;

#ifdef USE_FP16
    float eff_eps = max(push_constants.epsilon_val, 1e-4f);
    float p = clamp(float(pred_data[global_idx]), eff_eps, 1.0f - eff_eps);
    float y = float(target_data[global_idx]);
#else
    float p = clamp(pred_data[global_idx], push_constants.epsilon_val, 1.0f - push_constants.epsilon_val);
    float y = target_data[global_idx];
#endif

    float dL_pos = 0.0f;
    if (y > 0.0f) {
        float pt = 1.0f - p;
        if (push_constants.gamma_pos <= 0.0f) {
            dL_pos = -1.0f / p;
        } else {
            float pt_gamma_minus_1 = (push_constants.gamma_pos == 1.0f) ? 1.0f : pow(pt, push_constants.gamma_pos - 1.0f);
            float pt_gamma = pt_gamma_minus_1 * pt;
            dL_pos = push_constants.gamma_pos * pt_gamma_minus_1 * log(p) - (pt_gamma / p);
        }
    }

    float dL_neg = 0.0f;
    if (y < 1.0f) {
        float p_m = max(p - push_constants.clip_margin, 0.0f);
#ifdef USE_FP16
        p_m = clamp(p_m, 0.0f, 1.0f - eff_eps);
#else
        p_m = clamp(p_m, 0.0f, 1.0f - push_constants.epsilon_val);
#endif
        if (p_m > 0.0f) {
            float q_m = 1.0f - p_m;
            if (push_constants.gamma_neg <= 0.0f) {
                dL_neg = 1.0f / q_m;
            } else {
                float pm_gamma_minus_1 = (push_constants.gamma_neg == 1.0f) ? 1.0f : pow(p_m, push_constants.gamma_neg - 1.0f);
                float pm_gamma = pm_gamma_minus_1 * p_m;
                dL_neg = -push_constants.gamma_neg * pm_gamma_minus_1 * log(q_m) + (pm_gamma / q_m);
            }
        }
    }

#ifdef USE_FP16
    float total_grad = (y * dL_pos + (1.0f - y) * dL_neg) * push_constants.inv_total_elements;
    if (isnan(total_grad) || isinf(total_grad)) total_grad = 0.0f;
    else total_grad = clamp(total_grad, -65504.0f, 65504.0f);
    grad_data[global_idx] = float16_t(total_grad);
#else
    float total_grad = y * dL_pos + (1.0f - y) * dL_neg;
    grad_data[global_idx] = total_grad * push_constants.inv_total_elements;
#endif
}
