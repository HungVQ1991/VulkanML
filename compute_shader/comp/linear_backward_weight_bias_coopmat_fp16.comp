#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require

#define TILE_M 16
#define TILE_N 16
#define TILE_K 16

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer InputX {
    float16_t x_data[];
};

layout(std430, set = 0, binding = 1) readonly buffer GradY {
    float16_t dy_data[];
};

layout(std430, set = 0, binding = 2) buffer GradW {
    float dw_data[];
};

layout(std430, set = 0, binding = 3) buffer GradB {
    float db_data[];
};

layout(push_constant) uniform PushConstants {
    uint batch_size; // M (tokens)
    uint in_dim;     // K (input dimension)
    uint out_dim;    // N (output dimension)
    uint accumulate; // 1 or 0
} params;

shared float16_t smem_a[TILE_M * TILE_K];
shared float16_t smem_b[TILE_K * TILE_N];
shared float smem_c[TILE_M * TILE_N];

void main() {
    uint tile_col = gl_WorkGroupID.x * TILE_N; // along out_dim (N)
    uint tile_row = gl_WorkGroupID.y * TILE_M; // along in_dim (K)

    if (tile_row >= params.in_dim || tile_col >= params.out_dim) return;

    uint lane_id = gl_LocalInvocationID.x;

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc;
    acc = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

    float db_accum = 0.0;
    bool is_k_aligned = (tile_row + TILE_M <= params.in_dim);
    bool is_n_aligned = (tile_col + TILE_N <= params.out_dim);

    for (uint m = 0; m < params.batch_size; m += TILE_K) {
        bool is_m_aligned = (m + TILE_K <= params.batch_size);

        // Load tile of X^T [16 x 16]: X^T(r, c) = X(m + c, tile_row + r)
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matA;
        for (uint i = 0; i < 8; ++i) {
            uint idx = lane_id * 8 + i;
            uint r = idx / TILE_K;
            uint c = idx % TILE_K;
            uint gx_row = m + c;
            uint gx_col = tile_row + r;
            smem_a[idx] = (gx_row < params.batch_size && gx_col < params.in_dim)
                ? x_data[gx_row * params.in_dim + gx_col]
                : float16_t(0.0);
        }
        barrier();
        coopMatLoad(matA, smem_a, 0, TILE_K, gl_CooperativeMatrixLayoutRowMajor);
        barrier();

        // Load tile of dY [16 x 16] (Row-major)
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> matB;
        if (gl_WorkGroupID.y == 0) {
            // Need to accumulate bias dB along columns
            for (uint i = 0; i < 8; ++i) {
                uint idx = lane_id * 8 + i;
                uint r = idx / TILE_N;
                uint c = idx % TILE_N;
                uint gdy_row = m + r;
                uint gdy_col = tile_col + c;
                smem_b[idx] = (gdy_row < params.batch_size && gdy_col < params.out_dim)
                    ? dy_data[gdy_row * params.out_dim + gdy_col]
                    : float16_t(0.0);
            }
            barrier();
            coopMatLoad(matB, smem_b, 0, TILE_N, gl_CooperativeMatrixLayoutRowMajor);

            if (lane_id < 16) {
                float col_sum = 0.0;
                for (uint r = 0; r < 16; ++r) {
                    col_sum += float(smem_b[r * 16 + lane_id]);
                }
                db_accum += col_sum;
            }
            barrier();
        } else {
            if (is_m_aligned && is_n_aligned) {
                coopMatLoad(matB, dy_data, m * params.out_dim + tile_col, params.out_dim, gl_CooperativeMatrixLayoutRowMajor);
            } else {
                for (uint i = 0; i < 8; ++i) {
                    uint idx = lane_id * 8 + i;
                    uint r = idx / TILE_N;
                    uint c = idx % TILE_N;
                    uint gdy_row = m + r;
                    uint gdy_col = tile_col + c;
                    smem_b[idx] = (gdy_row < params.batch_size && gdy_col < params.out_dim)
                        ? dy_data[gdy_row * params.out_dim + gdy_col]
                        : float16_t(0.0);
                }
                barrier();
                coopMatLoad(matB, smem_b, 0, TILE_N, gl_CooperativeMatrixLayoutRowMajor);
                barrier();
            }
        }

        acc = coopMatMulAdd(matA, matB, acc);
    }

    // Write out dW
    if (params.accumulate == 0 && is_k_aligned && is_n_aligned) {
        coopMatStore(acc, dw_data, tile_row * params.out_dim + tile_col, params.out_dim, gl_CooperativeMatrixLayoutRowMajor);
    } else {
        coopMatStore(acc, smem_c, 0, TILE_N, gl_CooperativeMatrixLayoutRowMajor);
        barrier();
        for (uint i = 0; i < 8; ++i) {
            uint idx = lane_id * 8 + i;
            uint lr = idx / TILE_N;
            uint lc = idx % TILE_N;
            uint gr = tile_row + lr;
            uint gc = tile_col + lc;
            if (gr < params.in_dim && gc < params.out_dim) {
                float val = smem_c[idx];
                if (isnan(val) || isinf(val)) val = 0.0;
                if (params.accumulate != 0) {
                    dw_data[gr * params.out_dim + gc] += val;
                } else {
                    dw_data[gr * params.out_dim + gc] = val;
                }
            }
        }
    }

    // Write out dB
    if (gl_WorkGroupID.y == 0 && lane_id < 16) {
        uint gc = tile_col + lane_id;
        if (gc < params.out_dim) {
            if (isnan(db_accum) || isinf(db_accum)) db_accum = 0.0;
            if (params.accumulate != 0) {
                db_data[gc] += db_accum;
            } else {
                db_data[gc] = db_accum;
            }
        }
    }
}
