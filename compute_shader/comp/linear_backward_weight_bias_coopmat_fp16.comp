#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require

#define TILE_M 64u
#define TILE_N 64u
#define TILE_K 32u
#define SMEM_STRIDE 9u

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer InputX      { float16_t x_data[]; };
layout(std430, set = 0, binding = 0) readonly buffer InputX_V4   { uvec4     x_data4[]; };
layout(std430, set = 0, binding = 0) readonly buffer PartialsF32 { float     partials_f32[]; };
layout(std430, set = 0, binding = 1) readonly buffer GradY       { float16_t dy_data[]; };
layout(std430, set = 0, binding = 1) readonly buffer GradY_V4    { uvec4     dy_data4[]; };
layout(std430, set = 0, binding = 2) buffer GradW { float dw_data[]; };
layout(std430, set = 0, binding = 3) buffer GradB { float db_data[]; };

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint in_dim;
    uint out_dim;
    uint accumulate;
    uint split_k;
    uint pass_mode;
} params;

shared uvec4 smem_x[TILE_K * SMEM_STRIDE];
shared uvec4 smem_dy[TILE_K * SMEM_STRIDE];
shared float smem_c[4u * 256u];

uvec4 pack8FromX(uint gr, uint gc, uint rows, uint cols) {
    if (gr >= rows || gc >= cols) return uvec4(0u);
    uint row_off = gr * cols;
    float h0 = float(x_data[row_off + gc]);
    float h1 = (gc + 1u < cols) ? float(x_data[row_off + gc + 1u]) : 0.0;
    float h2 = (gc + 2u < cols) ? float(x_data[row_off + gc + 2u]) : 0.0;
    float h3 = (gc + 3u < cols) ? float(x_data[row_off + gc + 3u]) : 0.0;
    float h4 = (gc + 4u < cols) ? float(x_data[row_off + gc + 4u]) : 0.0;
    float h5 = (gc + 5u < cols) ? float(x_data[row_off + gc + 5u]) : 0.0;
    float h6 = (gc + 6u < cols) ? float(x_data[row_off + gc + 6u]) : 0.0;
    float h7 = (gc + 7u < cols) ? float(x_data[row_off + gc + 7u]) : 0.0;
    return uvec4(
        packHalf2x16(vec2(h0, h1)),
        packHalf2x16(vec2(h2, h3)),
        packHalf2x16(vec2(h4, h5)),
        packHalf2x16(vec2(h6, h7))
    );
}

uvec4 pack8FromDY(uint gr, uint gc, uint rows, uint cols) {
    if (gr >= rows || gc >= cols) return uvec4(0u);
    uint row_off = gr * cols;
    float h0 = float(dy_data[row_off + gc]);
    float h1 = (gc + 1u < cols) ? float(dy_data[row_off + gc + 1u]) : 0.0;
    float h2 = (gc + 2u < cols) ? float(dy_data[row_off + gc + 2u]) : 0.0;
    float h3 = (gc + 3u < cols) ? float(dy_data[row_off + gc + 3u]) : 0.0;
    float h4 = (gc + 4u < cols) ? float(dy_data[row_off + gc + 4u]) : 0.0;
    float h5 = (gc + 5u < cols) ? float(dy_data[row_off + gc + 5u]) : 0.0;
    float h6 = (gc + 6u < cols) ? float(dy_data[row_off + gc + 6u]) : 0.0;
    float h7 = (gc + 7u < cols) ? float(dy_data[row_off + gc + 7u]) : 0.0;
    return uvec4(
        packHalf2x16(vec2(h0, h1)),
        packHalf2x16(vec2(h2, h3)),
        packHalf2x16(vec2(h4, h5)),
        packHalf2x16(vec2(h6, h7))
    );
}

#define STORE_DW_SUBTILE(ACC_VAR, SUB_ROW, SUB_COL)                                                         \
    do {                                                                                                    \
        uint _sr = (SUB_ROW);                                                                               \
        uint _sc = (SUB_COL);                                                                               \
        if (_sr < in_dim && _sc < out_dim) {                                                                \
            if (!effective_acc && out_vec_aligned && (_sr + 16u <= in_dim) && (_sc + 16u <= out_dim)) {     \
                coopMatStore(ACC_VAR, dw_data, w_slice_off + _sr * out_dim + _sc, out_dim,                  \
                             gl_CooperativeMatrixLayoutRowMajor);                                           \
            } else {                                                                                        \
                coopMatStore(ACC_VAR, smem_c, wave_base, 16u, gl_CooperativeMatrixLayoutRowMajor);          \
                controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared,               \
                               gl_SemanticsAcquireRelease);                                                 \
                for (uint _i = 0u; _i < 8u; ++_i) {                                                         \
                    uint _idx = lane_id + _i * 32u;                                                         \
                    uint _gr = _sr + (_idx >> 4u);                                                          \
                    uint _gc = _sc + (_idx & 15u);                                                          \
                    if (_gr < in_dim && _gc < out_dim) {                                                    \
                        float _val = smem_c[wave_base + _idx];                                              \
                        uint _dst = w_slice_off + _gr * out_dim + _gc;                                      \
                        if (effective_acc) {                                                                \
                            dw_data[_dst] += _val;                                                          \
                        } else {                                                                            \
                            dw_data[_dst] = _val;                                                           \
                        }                                                                                   \
                    }                                                                                       \
                }                                                                                           \
                controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared,               \
                               gl_SemanticsAcquireRelease);                                                 \
            }                                                                                               \
        }                                                                                                   \
    } while (false)

void main() {
    uint batch_size = params.batch_size;
    uint in_dim     = params.in_dim;
    uint out_dim    = params.out_dim;

    if (params.pass_mode == 2u) {
        uint w_elems = in_dim * out_dim;
        uint total   = w_elems + out_dim;
        uint gid     = gl_GlobalInvocationID.x;
        if (gid >= total) return;

        uint sk = max(params.split_k, 1u);
        if (gid < w_elems) {
            float sum = 0.0;
            for (uint s = 0u; s < sk; ++s) {
                sum += partials_f32[s * w_elems + gid];
            }
            if (params.accumulate != 0u) {
                dw_data[gid] += sum;
            } else {
                dw_data[gid] = sum;
            }
        } else {
            uint col    = gid - w_elems;
            uint b_base = sk * w_elems;
            float sum   = 0.0;
            for (uint s = 0u; s < sk; ++s) {
                sum += partials_f32[b_base + s * out_dim + col];
            }
            if (params.accumulate != 0u) {
                db_data[col] += sum;
            } else {
                db_data[col] = sum;
            }
        }
        return;
    }

    uint tile_col = gl_WorkGroupID.x * TILE_N;
    uint tile_row = gl_WorkGroupID.y * TILE_M;
    if (tile_row >= in_dim || tile_col >= out_dim) return;

    uint tid       = gl_LocalInvocationID.x;
    uint wave_id   = tid >> 5u;
    uint lane_id   = tid & 31u;
    uint wave_m    = wave_id >> 1u;
    uint wave_n    = wave_id & 1u;
    uint wave_base = wave_id * 256u;

    uint sk            = (params.pass_mode == 1u) ? max(params.split_k, 1u) : 1u;
    uint split_idx     = (params.pass_mode == 1u) ? gl_WorkGroupID.z : 0u;
    uint w_slice_off   = split_idx * (in_dim * out_dim);
    bool effective_acc = (params.pass_mode == 0u) && (params.accumulate != 0u);

    uint total_k_blocks = (batch_size + TILE_K - 1u) / TILE_K;
    uint blk_start      = (params.pass_mode == 1u) ? ((split_idx * total_k_blocks) / sk) : 0u;
    uint blk_end        = (params.pass_mode == 1u) ? (((split_idx + 1u) * total_k_blocks) / sk) : total_k_blocks;
    uint m_start        = blk_start * TILE_K;
    uint m_end          = min(batch_size, blk_end * TILE_K);

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc00 = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc01 = acc00;
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc10 = acc00;
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc11 = acc00;

    bool compute_db  = (gl_WorkGroupID.y == 0u);
    vec2 db_pair_acc = vec2(0.0);
    uint db_v4_idx   = lane_id >> 2u;
    uint db_comp     = lane_id & 3u;

    bool in_vec_aligned  = ((in_dim & 7u) == 0u);
    bool out_vec_aligned = ((out_dim & 7u) == 0u);

    uint r0 = tid >> 3u;
    uint r1 = r0 + 16u;
    uint c4 = tid & 7u;
    uint c8 = c4 * 8u;

    bool fast_path = in_vec_aligned && out_vec_aligned &&
                     (tile_row + TILE_M <= in_dim) &&
                     (tile_col + TILE_N <= out_dim) &&
                     (m_end > m_start) && (((m_end - m_start) & 31u) == 0u);

    if (fast_path) {
        uint in_stride4  = in_dim >> 3u;
        uint out_stride4 = out_dim >> 3u;
        uint x_base4     = (tile_row >> 3u) + c4;
        uint dy_base4    = (tile_col >> 3u) + c4;
        uint num_k       = (m_end - m_start) >> 5u;

        uint gx0 = m_start + r0;
        uint gx1 = m_start + r1;
        smem_x[r0 * SMEM_STRIDE + c4]  = x_data4[gx0 * in_stride4 + x_base4];
        smem_x[r1 * SMEM_STRIDE + c4]  = x_data4[gx1 * in_stride4 + x_base4];
        smem_dy[r0 * SMEM_STRIDE + c4] = dy_data4[gx0 * out_stride4 + dy_base4];
        smem_dy[r1 * SMEM_STRIDE + c4] = dy_data4[gx1 * out_stride4 + dy_base4];
        barrier();

        for (uint ki = 0u; ki < num_k; ++ki) {
            bool has_next = (ki + 1u < num_k);
            uvec4 next_x0, next_x1, next_dy0, next_dy1;
            if (has_next) {
                uint ng0 = m_start + (ki + 1u) * TILE_K + r0;
                uint ng1 = ng0 + 16u;
                next_x0  = x_data4[ng0 * in_stride4 + x_base4];
                next_x1  = x_data4[ng1 * in_stride4 + x_base4];
                next_dy0 = dy_data4[ng0 * out_stride4 + dy_base4];
                next_dy1 = dy_data4[ng1 * out_stride4 + dy_base4];
            }

            for (uint m_sub = 0u; m_sub < 2u; ++m_sub) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matA0, matA1;
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> matB0, matB1;

                uint a_off0 = (m_sub * 16u) * SMEM_STRIDE + ((wave_m * 32u)        >> 3u);
                uint a_off1 = (m_sub * 16u) * SMEM_STRIDE + ((wave_m * 32u + 16u)  >> 3u);
                uint b_off0 = (m_sub * 16u) * SMEM_STRIDE + ((wave_n * 32u)        >> 3u);
                uint b_off1 = (m_sub * 16u) * SMEM_STRIDE + ((wave_n * 32u + 16u)  >> 3u);

                coopMatLoad(matA0, smem_x,  a_off0, SMEM_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
                coopMatLoad(matA1, smem_x,  a_off1, SMEM_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
                coopMatLoad(matB0, smem_dy, b_off0, SMEM_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(matB1, smem_dy, b_off1, SMEM_STRIDE, gl_CooperativeMatrixLayoutRowMajor);

                acc00 = coopMatMulAdd(matA0, matB0, acc00);
                acc01 = coopMatMulAdd(matA0, matB1, acc01);
                acc10 = coopMatMulAdd(matA1, matB0, acc10);
                acc11 = coopMatMulAdd(matA1, matB1, acc11);
            }

            if (compute_db) {
                uint dy_row_base = wave_id * 8u;
                for (uint r = 0u; r < 8u; ++r) {
                    uvec4 v = smem_dy[(dy_row_base + r) * SMEM_STRIDE + db_v4_idx];
                    uint packed = (db_comp == 0u) ? v.x : ((db_comp == 1u) ? v.y : ((db_comp == 2u) ? v.z : v.w));
                    db_pair_acc += unpackHalf2x16(packed);
                }
            }

            if (has_next) {
                barrier();
                smem_x[r0 * SMEM_STRIDE + c4]  = next_x0;
                smem_x[r1 * SMEM_STRIDE + c4]  = next_x1;
                smem_dy[r0 * SMEM_STRIDE + c4] = next_dy0;
                smem_dy[r1 * SMEM_STRIDE + c4] = next_dy1;
                barrier();
            }
        }
    } else {
        for (uint m = m_start; m < m_end; m += TILE_K) {
            uint gm0 = m + r0;
            uint gm1 = m + r1;

            if (in_vec_aligned) {
                uint in_stride4 = in_dim >> 3u;
                uint tk4 = tile_row >> 3u;
                bool k_in = (tk4 + c4 < in_stride4);
                smem_x[r0 * SMEM_STRIDE + c4] = (gm0 < m_end && k_in) ? x_data4[gm0 * in_stride4 + tk4 + c4] : uvec4(0u);
                smem_x[r1 * SMEM_STRIDE + c4] = (gm1 < m_end && k_in) ? x_data4[gm1 * in_stride4 + tk4 + c4] : uvec4(0u);
            } else {
                smem_x[r0 * SMEM_STRIDE + c4] = pack8FromX(gm0, tile_row + c8, m_end, in_dim);
                smem_x[r1 * SMEM_STRIDE + c4] = pack8FromX(gm1, tile_row + c8, m_end, in_dim);
            }

            if (out_vec_aligned) {
                uint out_stride4 = out_dim >> 3u;
                uint tn4 = tile_col >> 3u;
                bool n_in = (tn4 + c4 < out_stride4);
                smem_dy[r0 * SMEM_STRIDE + c4] = (gm0 < m_end && n_in) ? dy_data4[gm0 * out_stride4 + tn4 + c4] : uvec4(0u);
                smem_dy[r1 * SMEM_STRIDE + c4] = (gm1 < m_end && n_in) ? dy_data4[gm1 * out_stride4 + tn4 + c4] : uvec4(0u);
            } else {
                smem_dy[r0 * SMEM_STRIDE + c4] = pack8FromDY(gm0, tile_col + c8, m_end, out_dim);
                smem_dy[r1 * SMEM_STRIDE + c4] = pack8FromDY(gm1, tile_col + c8, m_end, out_dim);
            }

            barrier();

            for (uint m_sub = 0u; m_sub < 2u; ++m_sub) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matA0, matA1;
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> matB0, matB1;

                uint a_off0 = (m_sub * 16u) * SMEM_STRIDE + ((wave_m * 32u)        >> 3u);
                uint a_off1 = (m_sub * 16u) * SMEM_STRIDE + ((wave_m * 32u + 16u)  >> 3u);
                uint b_off0 = (m_sub * 16u) * SMEM_STRIDE + ((wave_n * 32u)        >> 3u);
                uint b_off1 = (m_sub * 16u) * SMEM_STRIDE + ((wave_n * 32u + 16u)  >> 3u);

                coopMatLoad(matA0, smem_x,  a_off0, SMEM_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
                coopMatLoad(matA1, smem_x,  a_off1, SMEM_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
                coopMatLoad(matB0, smem_dy, b_off0, SMEM_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(matB1, smem_dy, b_off1, SMEM_STRIDE, gl_CooperativeMatrixLayoutRowMajor);

                acc00 = coopMatMulAdd(matA0, matB0, acc00);
                acc01 = coopMatMulAdd(matA0, matB1, acc01);
                acc10 = coopMatMulAdd(matA1, matB0, acc10);
                acc11 = coopMatMulAdd(matA1, matB1, acc11);
            }

            if (compute_db) {
                uint dy_row_base = wave_id * 8u;
                for (uint r = 0u; r < 8u; ++r) {
                    uvec4 v = smem_dy[(dy_row_base + r) * SMEM_STRIDE + db_v4_idx];
                    uint packed = (db_comp == 0u) ? v.x : ((db_comp == 1u) ? v.y : ((db_comp == 2u) ? v.z : v.w));
                    db_pair_acc += unpackHalf2x16(packed);
                }
            }

            barrier();
        }
    }

    uint base_r = tile_row + wave_m * 32u;
    uint base_c = tile_col + wave_n * 32u;

    STORE_DW_SUBTILE(acc00, base_r,       base_c);
    STORE_DW_SUBTILE(acc01, base_r,       base_c + 16u);
    STORE_DW_SUBTILE(acc10, base_r + 16u, base_c);
    STORE_DW_SUBTILE(acc11, base_r + 16u, base_c + 16u);

    if (compute_db) {
        barrier();
        smem_c[wave_id * 64u + lane_id * 2u]      = db_pair_acc.x;
        smem_c[wave_id * 64u + lane_id * 2u + 1u] = db_pair_acc.y;
        barrier();
        if (tid < 64u) {
            uint gc = tile_col + tid;
            if (gc < out_dim) {
                float total = (smem_c[tid] + smem_c[64u + tid]) + (smem_c[128u + tid] + smem_c[192u + tid]);
                if (params.pass_mode == 1u) {
                    db_data[sk * (in_dim * out_dim) + split_idx * out_dim + gc] = total;
                } else if (params.accumulate != 0u) {
                    db_data[gc] += total;
                } else {
                    db_data[gc] = total;
                }
            }
        }
    }
}
