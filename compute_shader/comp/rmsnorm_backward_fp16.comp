#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer GradOutBuffer { float16_t grad_out[]; };
layout(std430, binding = 1) readonly buffer InBuffer { float16_t in_data[]; };
layout(std430, binding = 2) readonly buffer GammaBuffer { float16_t gamma_data[]; };
layout(std430, binding = 3) readonly buffer InvRmsBuffer { float inv_rms_data[]; };
layout(std430, binding = 4) writeonly buffer GradInBuffer { float16_t grad_in[]; };
layout(std430, binding = 5) buffer GradGammaBuffer { float grad_gamma[]; };

layout(push_constant) uniform Constants {
    uint batch_size;
    uint dim;
    uint accumulate;
} pcs;

shared float s_subgroup_sums[32];
shared float s_sum_dy_gamma_x;

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= pcs.batch_size) return;

    uint lid = gl_LocalInvocationID.x;
    uint row_offset = row * pcs.dim;
    float inv_rms = inv_rms_data[row];

    // Step 1: Accumulate local dot product: sum(grad_out * gamma * (x * inv_rms))
    float local_sum = 0.0;
    for (uint c = lid; c < pcs.dim; c += 256) {
        float dy = float(grad_out[row_offset + c]);
        float g = float(gamma_data[c]);
        float x = float(in_data[row_offset + c]);
        if (isnan(dy) || isinf(dy)) dy = 0.0;
        if (isnan(g) || isinf(g)) g = 1.0;
        if (isnan(x) || isinf(x)) x = 0.0;
        float x_hat = (isnan(inv_rms) || isinf(inv_rms)) ? 0.0 : (x * inv_rms);
        float term = dy * g * x_hat;
        if (!isnan(term) && !isinf(term)) {
            local_sum += term;
        }
    }

    // Step 2: Intra-subgroup reduction
    #ifdef GL_KHR_shader_subgroup_arithmetic
    local_sum = subgroupAdd(local_sum);
    #endif

    uint sg_id = gl_SubgroupID;
    uint num_sg = gl_NumSubgroups;

    if (subgroupElect()) {
        s_subgroup_sums[sg_id] = local_sum;
    }
    barrier();

    // Step 3: Inter-subgroup reduction by the first subgroup
    if (sg_id == 0) {
        float val = (lid < num_sg) ? s_subgroup_sums[lid] : 0.0;
        #ifdef GL_KHR_shader_subgroup_arithmetic
        val = subgroupAdd(val);
        #endif
        if (lid == 0) {
            s_sum_dy_gamma_x = val;
        }
    }
    barrier();

    float sum_dy_gamma_x = s_sum_dy_gamma_x;
    float inv_dim = 1.0 / float(pcs.dim);

    // Step 4: Compute dx_i = inv_rms * (dy_i * gamma_i - x_hat_i * (sum_dy_gamma_x / D))
    for (uint c = lid; c < pcs.dim; c += 256) {
        float dy = float(grad_out[row_offset + c]);
        float g = float(gamma_data[c]);
        float x = float(in_data[row_offset + c]);
        if (isnan(dy) || isinf(dy)) dy = 0.0;
        if (isnan(g) || isinf(g)) g = 1.0;
        if (isnan(x) || isinf(x)) x = 0.0;
        float x_hat = (isnan(inv_rms) || isinf(inv_rms)) ? 0.0 : (x * inv_rms);
        float dx = inv_rms * (dy * g - x_hat * (sum_dy_gamma_x * inv_dim));
        if (isnan(dx) || isinf(dx)) dx = 0.0;
        grad_in[row_offset + c] = float16_t(clamp(dx, -65504.0, 65504.0));
    }

    // Step 5: Workgroup 0 computes grad_gamma across all rows
    if (row == 0) {
        for (uint c = lid; c < pcs.dim; c += 256) {
            float sum = 0.0;
            for (uint r = 0; r < pcs.batch_size; ++r) {
                float dy = float(grad_out[r * pcs.dim + c]);
                float x = float(in_data[r * pcs.dim + c]);
                float inv_rms_val = inv_rms_data[r];
                if (isnan(dy) || isinf(dy)) dy = 0.0;
                if (isnan(x) || isinf(x)) x = 0.0;
                if (isnan(inv_rms_val) || isinf(inv_rms_val)) inv_rms_val = 0.0;
                float term = dy * (x * inv_rms_val);
                if (!isnan(term) && !isinf(term)) {
                    sum += term;
                }
            }
            if (isnan(sum) || isinf(sum)) sum = 0.0;
            if (pcs.accumulate != 0) {
                grad_gamma[c] += sum;
            } else {
                grad_gamma[c] = sum;
            }
        }
    }
}
