#version 450

layout(local_size_x = 1, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer QBuffer  { float q_data[]; };
layout(std430, binding = 1) readonly buffer KBuffer  { float k_data[]; };
layout(std430, binding = 2) readonly buffer VBuffer  { float v_data[]; };
layout(std430, binding = 3) readonly buffer OBuffer  { float o_data[]; };
layout(std430, binding = 4) readonly buffer DOBuffer { float do_data[]; };
layout(std430, binding = 5) buffer DQBuffer          { float dq_data[]; };
layout(std430, binding = 6) buffer DKBuffer          { float dk_data[]; };
layout(std430, binding = 7) buffer DVBuffer          { float dv_data[]; };
layout(std430, binding = 8) buffer LBuffer           { float l_data[]; };
layout(std430, binding = 9) readonly buffer MaskBuffer { float mask_data[]; };

layout(push_constant) uniform Constants {
    uint batch_size;
    uint q_seq_len;
    uint kv_seq_len;
    uint head_dim;
    uint mask_mode;
    uint causal_offset;
    float scale;
    uint pass_type;
    uint recompute_l;
    uint gqa_group_size;
    uint num_heads;
    uint is_bshd;
    uint mask_stride_batch;
    uint mask_per_head;
} pcs;

bool isAllowed(uint q_head_linear, uint batch_idx, uint q_pos, uint k_pos) {
    if (pcs.mask_mode == 1u) {
        return k_pos <= pcs.causal_offset + q_pos;
    }
    if (pcs.mask_mode == 2u) {
        uint mb = (pcs.mask_per_head != 0u) ? q_head_linear : batch_idx;
        return mask_data[mb * pcs.mask_stride_batch + q_pos * pcs.kv_seq_len + k_pos] > 0.5;
    }
    return true;
}

void main() {
    uint b = gl_WorkGroupID.z;
    uint idx = gl_GlobalInvocationID.y;
    uint S = pcs.q_seq_len;
    uint T = pcs.kv_seq_len;
    uint D = pcs.head_dim;
    uint group = max(pcs.gqa_group_size, 1u);
    uint H = max(pcs.num_heads, 1u);
    uint H_kv = max(H / group, 1u);

    if (b >= pcs.batch_size) return;

    if (pcs.pass_type == 0u) {
        if (idx >= S) return;
        uint batch_idx = b / H;
        uint head_idx = b % H;
        uint kv_head_idx = head_idx / group;

        uint q_head_base;
        uint q_row_stride;
        uint kv_head_base;
        uint kv_row_stride;
        if (pcs.is_bshd != 0u) {
            q_head_base = (batch_idx * S * H + head_idx) * D;
            q_row_stride = H * D;
            kv_head_base = (batch_idx * T * H_kv + kv_head_idx) * D;
            kv_row_stride = H_kv * D;
        } else {
            q_head_base = b * S * D;
            q_row_stride = D;
            kv_head_base = (b / group) * T * D;
            kv_row_stride = D;
        }
        uint i = idx;
        uint q_base = q_head_base + i * q_row_stride;
        uint max_j = (pcs.mask_mode == 1u) ? min(T, pcs.causal_offset + i + 1u) : T;

        float l_i = -1e20;
        if (pcs.recompute_l != 0u) {
            float m = -1e20;
            float l = 0.0;
            for (uint j = 0u; j < max_j; ++j) {
                if (!isAllowed(b, batch_idx, i, j)) continue;
                uint k_base = kv_head_base + j * kv_row_stride;
                float dot_val = 0.0;
                for (uint d = 0u; d < D; ++d) {
                    dot_val += q_data[q_base + d] * k_data[k_base + d];
                }
                float s_val = dot_val * pcs.scale;
                float m_new = max(m, s_val);
                l = l * exp(m - m_new) + exp(s_val - m_new);
                m = m_new;
            }
            l_i = (l > 0.0) ? (m + log(l)) : -1e20;
            l_data[b * S + i] = l_i;
        } else {
            l_i = l_data[b * S + i];
        }

        float di = 0.0;
        for (uint d = 0u; d < D; ++d) {
            di += do_data[q_base + d] * o_data[q_base + d];
            dq_data[q_base + d] = 0.0;
        }
        if (l_i <= -1e19) return;

        for (uint j = 0u; j < max_j; ++j) {
            if (!isAllowed(b, batch_idx, i, j)) continue;
            uint kv_base = kv_head_base + j * kv_row_stride;
            float dot_val = 0.0;
            float dp_val = 0.0;
            for (uint d = 0u; d < D; ++d) {
                dot_val += q_data[q_base + d] * k_data[kv_base + d];
                dp_val  += do_data[q_base + d] * v_data[kv_base + d];
            }
            float p_val = exp(dot_val * pcs.scale - l_i);
            float ds_val = p_val * (dp_val - di) * pcs.scale;
            for (uint d = 0u; d < D; ++d) {
                dq_data[q_base + d] += ds_val * k_data[kv_base + d];
            }
        }
    } else {
        if (idx >= T) return;
        uint kv_head_base;
        uint kv_row_stride;
        uint q_row_stride;
        uint batch_idx = 0u;
        uint kv_head_idx = 0u;
        if (pcs.is_bshd != 0u) {
            batch_idx = b / H_kv;
            kv_head_idx = b % H_kv;
            kv_head_base = (batch_idx * T * H_kv + kv_head_idx) * D;
            kv_row_stride = H_kv * D;
            q_row_stride = H * D;
        } else {
            batch_idx = (b * group) / H;
            kv_head_base = b * T * D;
            kv_row_stride = D;
            q_row_stride = D;
        }
        uint j = idx;
        uint kv_base = kv_head_base + j * kv_row_stride;
        for (uint d = 0u; d < D; ++d) {
            dk_data[kv_base + d] = 0.0;
            dv_data[kv_base + d] = 0.0;
        }

        uint start_i = 0u;
        if (pcs.mask_mode == 1u) {
            start_i = (j > pcs.causal_offset) ? (j - pcs.causal_offset) : 0u;
        }
        for (uint g = 0u; g < group; ++g) {
            uint q_b = b * group + g;
            uint q_head_base = (pcs.is_bshd != 0u)
                ? ((batch_idx * S * H + (kv_head_idx * group + g)) * D)
                : (q_b * S * D);
            for (uint i = start_i; i < S; ++i) {
                if (!isAllowed(q_b, batch_idx, i, j)) continue;
                uint q_base = q_head_base + i * q_row_stride;
                float l_i = l_data[q_b * S + i];
                if (l_i <= -1e19) continue;
                float di = 0.0;
                float dot_val = 0.0;
                float dp_val = 0.0;
                for (uint d = 0u; d < D; ++d) {
                    float do_d = do_data[q_base + d];
                    di      += do_d * o_data[q_base + d];
                    dot_val += q_data[q_base + d] * k_data[kv_base + d];
                    dp_val  += do_d * v_data[kv_base + d];
                }
                float p_val = exp(dot_val * pcs.scale - l_i);
                float ds_val = p_val * (dp_val - di) * pcs.scale;
                for (uint d = 0u; d < D; ++d) {
                    dk_data[kv_base + d] += ds_val * q_data[q_base + d];
                    dv_data[kv_base + d] += p_val * do_data[q_base + d];
                }
            }
        }
    }
}
