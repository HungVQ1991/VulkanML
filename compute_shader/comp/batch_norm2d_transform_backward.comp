#version 450
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#ifdef USE_FP16
layout(std430, binding = 0) readonly buffer GradOutput { float16_t dY[]; };
#else
layout(std430, binding = 0) readonly buffer GradOutput { float dY[]; };
#endif
layout(std430, binding = 1) readonly buffer XHat { float x_hat[]; };
layout(std430, binding = 2) readonly buffer Gamma { float gamma[]; };
layout(std430, binding = 3) readonly buffer GradGamma { float dgamma[]; };
layout(std430, binding = 4) readonly buffer GradBeta { float dbeta[]; };
layout(std430, binding = 5) readonly buffer BatchVar { float batch_var[]; };
#ifdef USE_FP16
layout(std430, binding = 6) writeonly buffer GradInput { float16_t dX[]; };
#else
layout(std430, binding = 6) writeonly buffer GradInput { float dX[]; };
#endif

layout(push_constant) uniform PushConstants {
    uint total_elements;
    uint channels;
    uint spatial_count;
    float epsilon;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total_elements) return;

    uint c = idx % pc.channels;

    float g = gamma[c];
    float v = batch_var[c];
    if (isnan(g) || isinf(g)) g = 1.0;
    if (isnan(v) || isinf(v) || v < 0.0) v = 1.0;

    float inv_std = 1.0 / sqrt(v + pc.epsilon);
#ifdef USE_FP16
    float dy = float(dY[idx]);
#else
    float dy = dY[idx];
#endif
    if (isnan(dy) || isinf(dy)) dy = 0.0;

    if (pc.spatial_count == 0) {
        float dx_val = g * inv_std * dy;
        if (isnan(dx_val) || isinf(dx_val)) dx_val = 0.0;
#ifdef USE_FP16
        dx_val = clamp(dx_val, -65504.0, 65504.0);
        dX[idx] = float16_t(dx_val);
#else
        dX[idx] = dx_val;
#endif
        return;
    }

    float dg = dgamma[c];
    float db = dbeta[c];
    float m = float(pc.spatial_count);

    if (isnan(dg) || isinf(dg)) dg = 0.0;
    if (isnan(db) || isinf(db)) db = 0.0;

    float xh = x_hat[idx];
    if (isnan(xh) || isinf(xh)) xh = 0.0;

    float dx_val = (g * inv_std / m) * (m * dy - db - xh * dg);
    if (isnan(dx_val) || isinf(dx_val)) dx_val = 0.0;
#ifdef USE_FP16
    dx_val = clamp(dx_val, -65504.0, 65504.0);
    dX[idx] = float16_t(dx_val);
#else
    dX[idx] = dx_val;
#endif
}
