#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

#define WORKGROUP_SIZE 32

layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Output_P { float16_t p_data[]; };
layout(std430, binding = 1) readonly buffer Grad_In { float16_t grad_in[]; };
layout(std430, binding = 2) writeonly buffer Grad_Out { float16_t grad_out[]; };

layout(push_constant) uniform Softmax_Dimensions {
    uint rows;
    uint cols;
} dims;

shared float shared_mem[WORKGROUP_SIZE];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;

    if (row >= dims.rows) return;
    uint offset = row * dims.cols;

    float local_dot = 0.0;
    for (uint c = tid; c < dims.cols; c += WORKGROUP_SIZE) {
        local_dot += float(p_data[offset + c]) * float(grad_in[offset + c]);
    }
    shared_mem[tid] = local_dot;
    barrier();

    for (uint stride = WORKGROUP_SIZE / 2; stride > 0; stride >>= 1) {
        if (tid < stride) {
            shared_mem[tid] += shared_mem[tid + stride];
        }
        barrier();
    }
    float dot_product = shared_mem[0];
    barrier();

    for (uint c = tid; c < dims.cols; c += WORKGROUP_SIZE) {
        float p_val = float(p_data[offset + c]);
        float g_val = float(grad_in[offset + c]);
        float res = p_val * (g_val - dot_product);
        grad_out[offset + c] = float16_t(clamp(res, -65504.0, 65504.0));
    }
}
