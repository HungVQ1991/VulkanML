#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer MasterWeights {
    float w_master[];
};

layout(std430, binding = 1) readonly buffer GammaBuffer {
    float gamma;
    float inv_gamma;
};

layout(std430, binding = 2) writeonly buffer EffectiveWeights {
    float16_t w_eff[];
};

layout(push_constant) uniform PushConstants {
    uint total_elements;
} pcs;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pcs.total_elements) return;

    float w = w_master[idx];
    precise float q = clamp(sign(w) * floor(abs(w) * inv_gamma + 0.5), -1.0, 1.0);
    w_eff[idx] = float16_t(q * gamma);
}
