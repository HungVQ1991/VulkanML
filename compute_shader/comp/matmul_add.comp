#version 450
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif

#define TILE_SIZE 16

layout(local_size_x = TILE_SIZE, local_size_y = TILE_SIZE, local_size_z = 1) in;

#ifdef USE_FP16
layout(std430, binding = 0) readonly buffer Matrix_X { float16_t data_x[]; };
layout(std430, binding = 1) readonly buffer Matrix_W { float16_t data_w[]; };
layout(std430, binding = 2) readonly buffer Matrix_B { float16_t data_b[]; };
layout(std430, binding = 3) writeonly buffer Matrix_Y { float16_t data_y[]; };
#else
layout(std430, binding = 0) readonly buffer Matrix_X { float data_x[]; };
layout(std430, binding = 1) readonly buffer Matrix_W { float data_w[]; };
layout(std430, binding = 2) readonly buffer Matrix_B { float data_b[]; };
layout(std430, binding = 3) writeonly buffer Matrix_Y { float data_y[]; };
#endif

layout(push_constant) uniform Push_Constants {
    uint batch_count;
    uint rows_x;
    uint cols_x;
    uint cols_w;
    uint broadcast_w;
    uint broadcast_b;
    uint batch_rank;
    uint pad0;
    uvec4 batch_dims;
    uvec4 a_batch_strides;
    uvec4 b_batch_strides;
} dims;

#ifdef USE_FP16
shared float16_t tile_x[TILE_SIZE][TILE_SIZE];
shared float16_t tile_w[TILE_SIZE][TILE_SIZE];
#else
shared float tile_x[TILE_SIZE][TILE_SIZE];
shared float tile_w[TILE_SIZE][TILE_SIZE];
#endif

void main() {
    uint col = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    uint batch = gl_GlobalInvocationID.z;

    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    if (batch >= dims.batch_count) return;

    float sum = 0.0;
    uint num_tiles = (dims.cols_x + TILE_SIZE - 1) / TILE_SIZE;

    uint x_batch_idx = batch;
    uint w_batch_idx = (dims.broadcast_w == 1u) ? 0u : batch;
    if (dims.batch_rank > 0u) {
        x_batch_idx = 0u;
        w_batch_idx = 0u;
        uint rem = batch;
        for (int d = int(dims.batch_rank) - 1; d >= 0; --d) {
            uint dim_d = dims.batch_dims[d];
            uint coord = rem % dim_d;
            rem /= dim_d;
            x_batch_idx += coord * dims.a_batch_strides[d];
            w_batch_idx += coord * dims.b_batch_strides[d];
        }
    }

    uint x_batch_offset = x_batch_idx * dims.rows_x * dims.cols_x;
    uint w_batch_offset = w_batch_idx * dims.cols_x * dims.cols_w;

    for (uint t = 0; t < num_tiles; ++t) {
        uint tiled_col_x = t * TILE_SIZE + local_col;
        if (row < dims.rows_x && tiled_col_x < dims.cols_x) {
            tile_x[local_row][local_col] = data_x[x_batch_offset + row * dims.cols_x + tiled_col_x];
        } else {
#ifdef USE_FP16
            tile_x[local_row][local_col] = float16_t(0.0);
#else
            tile_x[local_row][local_col] = 0.0;
#endif
        }

        uint tiled_row_w = t * TILE_SIZE + local_row;
        if (tiled_row_w < dims.cols_x && col < dims.cols_w) {
            tile_w[local_row][local_col] = data_w[w_batch_offset + tiled_row_w * dims.cols_w + col];
        } else {
#ifdef USE_FP16
            tile_w[local_row][local_col] = float16_t(0.0);
#else
            tile_w[local_row][local_col] = 0.0;
#endif
        }

        barrier();

        #pragma unroll
        for (uint k = 0; k < TILE_SIZE; ++k) {
#ifdef USE_FP16
            sum += float(tile_x[local_row][k]) * float(tile_w[k][local_col]);
#else
            sum += tile_x[local_row][k] * tile_w[k][local_col];
#endif
        }

        barrier();
    }

    if (row < dims.rows_x && col < dims.cols_w) {
        uint b_offset = (dims.broadcast_b == 1) ? col : ((dims.broadcast_b == 2) ? (row * dims.cols_w + col) : (batch * dims.rows_x * dims.cols_w + row * dims.cols_w + col));
#ifdef USE_FP16
        float val = sum + float(data_b[b_offset]);
        if (isnan(val) || isinf(val)) val = 0.0;
        data_y[batch * dims.rows_x * dims.cols_w + row * dims.cols_w + col] = float16_t(clamp(val, -65504.0, 65504.0));
#else
        data_y[batch * dims.rows_x * dims.cols_w + row * dims.cols_w + col] = sum + data_b[b_offset];
#endif
    }
}
