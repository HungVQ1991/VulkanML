#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InDQ   { float dq_data[]; };
layout(std430, binding = 1) readonly buffer InDK   { float dk_data[]; };
layout(std430, binding = 2) readonly buffer InDV   { float dv_data[]; };
layout(std430, binding = 3) writeonly buffer OutDQKV { float dqkv_data[]; };

layout(push_constant) uniform Constants {
    uint total_pairs;
    uint seq_len;
    uint head_dim;
    uint num_heads;
    uint num_kv_heads;
    uint mode;
    uint position_offset;
    float base;
} pcs;

vec2 computeInverseRopePair(float x0, float x1, uint token_pos, uint pair_idx) {
    float theta = pow(pcs.base, -2.0 * float(pair_idx) / float(pcs.head_dim));
    float alpha = -float(token_pos + pcs.position_offset) * theta;
    float cos_a = cos(alpha);
    float sin_a = sin(alpha);
    return vec2(x0 * cos_a - x1 * sin_a, x0 * sin_a + x1 * cos_a);
}

void main() {
    uint D = pcs.head_dim;
    if (D == 0u || (D & 1u) != 0u || pcs.seq_len == 0u || pcs.num_heads == 0u || pcs.num_kv_heads == 0u) return;

    uint wg_id = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint pair_id = wg_id * 256u + gl_LocalInvocationID.x;
    if (pair_id >= pcs.total_pairs) return;

    uint d_half = D >> 1u;
    uint q_pairs = pcs.num_heads * d_half;
    uint kv_pairs = pcs.num_kv_heads * d_half;
    uint tok_pairs = q_pairs + 2u * kv_pairs;

    uint row = pair_id / tok_pairs;
    uint lp = pair_id % tok_pairs;
    uint token_pos = row % pcs.seq_len;
    uint b = row / pcs.seq_len;

    uint out_base = pair_id * 2u;

    if (lp < q_pairs) {
        uint h = lp / d_half;
        uint pair_idx = lp % d_half;
        uint in_base = 2u * ((pcs.mode == 1u)
            ? (((b * pcs.num_heads + h) * pcs.seq_len + token_pos) * d_half + pair_idx)
            : (row * q_pairs + lp));
        vec2 r = computeInverseRopePair(dq_data[in_base], dq_data[in_base + 1u], token_pos, pair_idx);
        dqkv_data[out_base]      = r.x;
        dqkv_data[out_base + 1u] = r.y;
    } else if (lp < q_pairs + kv_pairs) {
        uint kp = lp - q_pairs;
        uint h = kp / d_half;
        uint pair_idx = kp % d_half;
        uint in_base = 2u * ((pcs.mode == 1u)
            ? (((b * pcs.num_kv_heads + h) * pcs.seq_len + token_pos) * d_half + pair_idx)
            : (row * kv_pairs + kp));
        vec2 r = computeInverseRopePair(dk_data[in_base], dk_data[in_base + 1u], token_pos, pair_idx);
        dqkv_data[out_base]      = r.x;
        dqkv_data[out_base + 1u] = r.y;
    } else {
        uint vp = lp - q_pairs - kv_pairs;
        uint h = vp / d_half;
        uint pair_idx = vp % d_half;
        uint in_base = 2u * ((pcs.mode == 1u)
            ? (((b * pcs.num_kv_heads + h) * pcs.seq_len + token_pos) * d_half + pair_idx)
            : (row * kv_pairs + vp));
        dqkv_data[out_base]      = dv_data[in_base];
        dqkv_data[out_base + 1u] = dv_data[in_base + 1u];
    }
}
