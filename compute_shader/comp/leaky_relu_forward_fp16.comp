#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer InputBuffer {
    float16_t X[];
};

layout(std430, set = 0, binding = 1) writeonly restrict buffer OutputBuffer {
    float16_t Y[];
};

layout(push_constant) uniform PushConstants {
    uint total_elements;
    float negative_slope;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total_elements) return;

    float16_t val = X[idx];
    Y[idx] = (val >= float16_t(0.0)) ? val : float16_t(val * float16_t(pc.negative_slope));
}
