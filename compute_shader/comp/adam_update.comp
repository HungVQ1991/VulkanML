#version 450
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) restrict buffer ParamBuffer      { float params[]; };
layout(std430, set = 0, binding = 0) restrict buffer ParamBuffer4     { vec4  params4[]; };
layout(std430, set = 0, binding = 1) readonly restrict buffer GradBuffer  { float grads[]; };
layout(std430, set = 0, binding = 1) readonly restrict buffer GradBuffer4 { vec4  grads4[]; };
layout(std430, set = 0, binding = 2) restrict buffer MBuffer          { float m_vec[]; };
layout(std430, set = 0, binding = 2) restrict buffer MBuffer4         { vec4  m_vec4[]; };
layout(std430, set = 0, binding = 3) restrict buffer VBuffer          { float v_vec[]; };
layout(std430, set = 0, binding = 3) restrict buffer VBuffer4         { vec4  v_vec4[]; };
layout(std430, set = 0, binding = 4) coherent restrict buffer DynamicParams {
    float lr;
    float inv_correction1;
    float inv_sqrt_correction2;
    float inv_scale;
    uint overflow_detected;
} dyn;
#ifdef USE_FP16
layout(std430, set = 0, binding = 5) writeonly restrict buffer Fp16ParamBuffer  { float16_t fp16_params[]; };
layout(std430, set = 0, binding = 5) writeonly restrict buffer Fp16ParamBuffer4 { f16vec4   fp16_params4[]; };
#endif

layout(push_constant) uniform PushConstants {
    uint total_size;
    float beta1;
    float beta2;
    float eps;
    float max_grad;
    float weight_decay;
} pc;

void adamScalarAt(uint idx, float lr, float inv_c1, float inv_sqrt_c2,
                  float inv_scale, float one_minus_b1, float one_minus_b2, inout bool saw_overflow) {
    float g = grads[idx] * inv_scale;
    if (isnan(g) || isinf(g)) {
        saw_overflow = true;
        return;
    }
    if (pc.max_grad > 0.0) {
        g = clamp(g, -pc.max_grad, pc.max_grad);
    }
    float m_val = fma(pc.beta1, m_vec[idx], one_minus_b1 * g);
    float v_val = fma(pc.beta2, v_vec[idx], one_minus_b2 * (g * g));
    m_vec[idx] = m_val;
    v_vec[idx] = v_val;

    float step_val = (m_val * inv_c1) / (sqrt(v_val) * inv_sqrt_c2 + pc.eps);
    float p = params[idx];
    if (pc.weight_decay > 0.0) {
        p -= lr * fma(pc.weight_decay, p, step_val);
    } else {
        p -= lr * step_val;
    }
    params[idx] = p;
#ifdef USE_FP16
    fp16_params[idx] = float16_t(clamp(p, -65504.0, 65504.0));
#endif
}

void main() {
    uint vec_idx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    uint base = vec_idx * 4u;
    if (base >= pc.total_size) return;

    float lr           = dyn.lr;
    float inv_c1       = dyn.inv_correction1;
    float inv_sqrt_c2  = dyn.inv_sqrt_correction2;
    float inv_scale    = dyn.inv_scale;
    float one_minus_b1 = 1.0 - pc.beta1;
    float one_minus_b2 = 1.0 - pc.beta2;
    bool  saw_overflow = false;

    if (base + 3u < pc.total_size) {
        vec4 g = grads4[vec_idx] * inv_scale;
        if (any(isnan(g)) || any(isinf(g))) {
            adamScalarAt(base,      lr, inv_c1, inv_sqrt_c2, inv_scale, one_minus_b1, one_minus_b2, saw_overflow);
            adamScalarAt(base + 1u, lr, inv_c1, inv_sqrt_c2, inv_scale, one_minus_b1, one_minus_b2, saw_overflow);
            adamScalarAt(base + 2u, lr, inv_c1, inv_sqrt_c2, inv_scale, one_minus_b1, one_minus_b2, saw_overflow);
            adamScalarAt(base + 3u, lr, inv_c1, inv_sqrt_c2, inv_scale, one_minus_b1, one_minus_b2, saw_overflow);
        } else {
            if (pc.max_grad > 0.0) {
                g = clamp(g, vec4(-pc.max_grad), vec4(pc.max_grad));
            }
            vec4 m_val = fma(vec4(pc.beta1), m_vec4[vec_idx], vec4(one_minus_b1) * g);
            vec4 v_val = fma(vec4(pc.beta2), v_vec4[vec_idx], vec4(one_minus_b2) * (g * g));
            m_vec4[vec_idx] = m_val;
            v_vec4[vec_idx] = v_val;

            vec4 step_val = (m_val * inv_c1) / (sqrt(v_val) * inv_sqrt_c2 + vec4(pc.eps));
            vec4 p = params4[vec_idx];
            if (pc.weight_decay > 0.0) {
                p -= lr * fma(vec4(pc.weight_decay), p, step_val);
            } else {
                p -= lr * step_val;
            }
            params4[vec_idx] = p;
#ifdef USE_FP16
            vec4 pc_clamped = clamp(p, vec4(-65504.0), vec4(65504.0));
            fp16_params4[vec_idx] = f16vec4(pc_clamped);
#endif
        }
    } else {
        for (uint k = 0u; k < 4u && base + k < pc.total_size; ++k) {
            adamScalarAt(base + k, lr, inv_c1, inv_sqrt_c2, inv_scale, one_minus_b1, one_minus_b2, saw_overflow);
        }
    }

    if (saw_overflow) {
        atomicOr(dyn.overflow_detected, 1u);
    }
}
