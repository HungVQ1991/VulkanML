#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer OutputBuffer {
    float16_t Y[];
};

layout(std430, set = 0, binding = 1) readonly restrict buffer GradOutputBuffer {
    float16_t dY[];
};

layout(std430, set = 0, binding = 2) writeonly restrict buffer GradInputBuffer {
    float16_t dX[];
};

layout(push_constant) uniform PushConstants {
    uint total_elements;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total_elements) return;

    float y = float(Y[idx]);
    float dy = float(dY[idx]);
    float grad = dy * y * (1.0f - y);
    if (isnan(grad) || isinf(grad)) {
        grad = 0.0f;
    } else {
        grad = clamp(grad, -65504.0f, 65504.0f);
    }
    dX[idx] = float16_t(grad);
}
