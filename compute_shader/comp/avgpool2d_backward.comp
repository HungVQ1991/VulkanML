#version 450
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer Grad_Output_Buffer {
#ifdef USE_FP16
    float16_t grad_output[];
#else
    float grad_output[];
#endif
};

layout(std430, set = 0, binding = 1) writeonly restrict buffer Grad_Input_Buffer {
#ifdef USE_FP16
    float16_t grad_input[];
#else
    float grad_input[];
#endif
};

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint in_h;
    uint in_w;
    uint channels;
    uint out_h;
    uint out_w;
    uint kernel_size;
    uint stride;
    uint padding;
} pc;

void main() {
    if (pc.in_h == 0u || pc.in_w == 0u || pc.stride == 0u || pc.kernel_size == 0u) return;
    uint c_idx = gl_GlobalInvocationID.x;
    uint in_w_idx = gl_GlobalInvocationID.y;
    uint n_in_h_idx = gl_GlobalInvocationID.z;

    uint total_in_h_batch = pc.batch_size * pc.in_h;
    if (c_idx >= pc.channels || in_w_idx >= pc.in_w || n_in_h_idx >= total_in_h_batch) {
        return;
    }

    uint n_idx = n_in_h_idx / pc.in_h;
    uint in_h_idx = n_in_h_idx % pc.in_h;

    uint in_idx = n_idx * (pc.in_h * pc.in_w * pc.channels) +
                  in_h_idx * (pc.in_w * pc.channels) +
                  in_w_idx * pc.channels + c_idx;

    float grad = 0.0;

    int pad = int(pc.padding);
    int k_sz = int(pc.kernel_size);
    int str = int(pc.stride);

    int ky_start = (int(in_h_idx) + pad) % str;
    int kx_start = (int(in_w_idx) + pad) % str;

    for (int ky = ky_start; ky < k_sz; ky += str) {
        int out_y_calc = int(in_h_idx) + pad - ky;
        if (out_y_calc < 0) continue;
        uint out_y = uint(out_y_calc / str);
        if (out_y < pc.out_h) {
            for (int kx = kx_start; kx < k_sz; kx += str) {
                int out_x_calc = int(in_w_idx) + pad - kx;
                if (out_x_calc < 0) continue;
                uint out_x = uint(out_x_calc / str);
                if (out_x < pc.out_w) {
                    uint out_idx = n_idx * (pc.out_h * pc.out_w * pc.channels) +
                                   out_y * (pc.out_w * pc.channels) +
                                   out_x * pc.channels + c_idx;
#ifdef USE_FP16
                    grad += float(grad_output[out_idx]) / float(k_sz * k_sz);
#else
                    grad += grad_output[out_idx] / float(k_sz * k_sz);
#endif
                }
            }
        }
    }

#ifdef USE_FP16
    grad_input[in_idx] = float16_t(grad);
#else
    grad_input[in_idx] = grad;
#endif
}
