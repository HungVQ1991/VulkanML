#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer InA { float16_t data_a[]; };
layout(std430, binding = 1) readonly buffer InB { float16_t data_b[]; };
layout(std430, binding = 2) writeonly buffer OutY { float16_t data_y[]; };

layout(push_constant) uniform Constants {
    uint total_elements;
} pcs;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pcs.total_elements) return;

    float a = float(data_a[idx]);
    float b = float(data_b[idx]);
    if (isnan(a) || isinf(a)) a = 0.0;
    if (isnan(b) || isinf(b)) b = 0.0;

    float sig_a = 1.0 / (1.0 + exp(-clamp(a, -85.0, 85.0)));
    float silu_a = a * sig_a;
    float y = silu_a * b;
    if (isnan(y) || isinf(y)) y = 0.0;

    data_y[idx] = float16_t(clamp(y, -65504.0, 65504.0));
}
