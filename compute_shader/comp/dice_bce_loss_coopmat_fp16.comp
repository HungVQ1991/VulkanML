#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require

#define TILE_M 16
#define TILE_N 16
#define TILE_K 16

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Pred_Buffer {
    float16_t pred_data[];
};

layout(std430, set = 0, binding = 1) readonly buffer Target_Buffer {
    float16_t target_data[];
};

layout(std430, set = 0, binding = 2) writeonly buffer Loss_Buffer {
    float loss_data[];
};

layout(push_constant) uniform Push_Constants {
    uint total_elements;
    float dice_weight;
    float bce_weight;
    float epsilon;
} pc;

shared float16_t smem_eye[TILE_M * TILE_K];
shared float16_t smem_in[TILE_M * TILE_N];
shared float smem_acc_inter[TILE_M * TILE_N];
shared float smem_acc_p[TILE_M * TILE_N];
shared float smem_acc_y[TILE_M * TILE_N];
shared float smem_bce_lanes[32];

void main() {
    uint lane_id = gl_LocalInvocationID.x;

    for (uint i = 0; i < 8; ++i) {
        uint idx = lane_id * 8 + i;
        uint r = idx / TILE_K;
        smem_eye[idx] = (r == 0) ? float16_t(1.0) : float16_t(0.0);
    }
    smem_bce_lanes[lane_id] = 0.0f;
    barrier();

    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matA;
    coopMatLoad(matA, smem_eye, 0, TILE_K, gl_CooperativeMatrixLayoutRowMajor);

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_inter;
    acc_inter = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_p;
    acc_p = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_y;
    acc_y = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

    float local_bce = 0.0f;

    for (uint base = 0; base < pc.total_elements; base += 256) {
        // Tile 1: pred_data
        for (uint i = 0; i < 8; ++i) {
            uint idx = lane_id * 8 + i;
            uint global_idx = base + idx;
            if (global_idx < pc.total_elements) {
                float p = clamp(float(pred_data[global_idx]), pc.epsilon, 1.0f - pc.epsilon);
                float y = float(target_data[global_idx]);
                smem_in[idx] = float16_t(p);
                local_bce += -(y * log(p) + (1.0f - y) * log(1.0f - p));
            } else {
                smem_in[idx] = float16_t(0.0);
            }
        }
        barrier();
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> matB_p;
        coopMatLoad(matB_p, smem_in, 0, TILE_N, gl_CooperativeMatrixLayoutRowMajor);
        acc_p = coopMatMulAdd(matA, matB_p, acc_p);
        barrier();

        // Tile 2: target_data
        for (uint i = 0; i < 8; ++i) {
            uint idx = lane_id * 8 + i;
            uint global_idx = base + idx;
            smem_in[idx] = (global_idx < pc.total_elements) ? target_data[global_idx] : float16_t(0.0);
        }
        barrier();
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> matB_y;
        coopMatLoad(matB_y, smem_in, 0, TILE_N, gl_CooperativeMatrixLayoutRowMajor);
        acc_y = coopMatMulAdd(matA, matB_y, acc_y);
        barrier();

        // Tile 3: intersection (p * y)
        for (uint i = 0; i < 8; ++i) {
            uint idx = lane_id * 8 + i;
            uint global_idx = base + idx;
            if (global_idx < pc.total_elements) {
                float p = clamp(float(pred_data[global_idx]), pc.epsilon, 1.0f - pc.epsilon);
                float y = float(target_data[global_idx]);
                smem_in[idx] = float16_t(p * y);
            } else {
                smem_in[idx] = float16_t(0.0);
            }
        }
        barrier();
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> matB_inter;
        coopMatLoad(matB_inter, smem_in, 0, TILE_N, gl_CooperativeMatrixLayoutRowMajor);
        acc_inter = coopMatMulAdd(matA, matB_inter, acc_inter);
        barrier();
    }

    coopMatStore(acc_inter, smem_acc_inter, 0, TILE_N, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(acc_p, smem_acc_p, 0, TILE_N, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(acc_y, smem_acc_y, 0, TILE_N, gl_CooperativeMatrixLayoutRowMajor);
    smem_bce_lanes[lane_id] = local_bce;
    barrier();

    if (lane_id == 0) {
        float total_inter = 0.0f;
        float total_pred = 0.0f;
        float total_target = 0.0f;
        float total_bce = 0.0f;

        for (uint c = 0; c < 16; ++c) {
            total_inter += smem_acc_inter[c];
            total_pred += smem_acc_p[c];
            total_target += smem_acc_y[c];
        }
        for (uint l = 0; l < 32; ++l) {
            total_bce += smem_bce_lanes[l];
        }

        float dice_denom = max(total_pred + total_target + pc.epsilon, 1e-4f);
        float dice_numer = 2.0f * total_inter + pc.epsilon;
        float dice_loss = 1.0f - (dice_numer / dice_denom);
        float bce_loss = total_bce / float(pc.total_elements);

        loss_data[0] = pc.dice_weight * dice_loss + pc.bce_weight * bce_loss;
        loss_data[1] = total_inter;
        loss_data[2] = total_pred;
        loss_data[3] = total_target;
    }
}
