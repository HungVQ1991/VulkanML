#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) restrict buffer WeightsBuffer {
    float weights[];
};

layout(std430, set = 0, binding = 1) readonly restrict buffer GradsBuffer {
    float grads[];
};

layout(std430, set = 0, binding = 2) coherent restrict buffer DynamicParams {
    float learning_rate;
    float pad0;
    float pad1;
    float inv_scale;
    uint overflow_detected;
} dyn;

layout(std430, set = 0, binding = 3) writeonly restrict buffer Fp16WeightsBuffer {
    float16_t fp16_weights[];
};

layout(push_constant) uniform PushConstants {
    uint total_elements;
    float max_gradient;
    float weight_decay;
} params;

void main() {
    uint idx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (idx >= params.total_elements) return;

    float g = grads[idx] * dyn.inv_scale;
    if (isnan(g) || isinf(g)) {
        atomicOr(dyn.overflow_detected, 1u);
        return;
    }

    if (params.max_gradient > 0.0f) {
        g = clamp(g, -params.max_gradient, params.max_gradient);
    }

    float p = weights[idx];
    if (params.weight_decay > 0.0f) {
        p -= dyn.learning_rate * (g + params.weight_decay * p);
    } else {
        p -= dyn.learning_rate * g;
    }

    weights[idx] = p;
    fp16_weights[idx] = float16_t(clamp(p, -65504.0f, 65504.0f));
}
