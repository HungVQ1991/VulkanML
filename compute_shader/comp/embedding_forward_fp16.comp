#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : enable

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer IndicesBuffer { float indices_data[]; };
layout(std430, binding = 1) readonly buffer WeightBuffer { float16_t weight_data[]; };
layout(std430, binding = 2) writeonly buffer OutputBuffer { float16_t output_data[]; };

layout(push_constant) uniform Constants {
    uint num_tokens;
    uint embedding_dim;
    uint vocab_size;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint total = pc.num_tokens * pc.embedding_dim;
    if (gid >= total) return;

    uint token_idx = gid / pc.embedding_dim;
    uint dim_idx = gid % pc.embedding_dim;

    int row = int(round(indices_data[token_idx]));
    if (row >= 0 && uint(row) < pc.vocab_size) {
        output_data[gid] = weight_data[uint(row) * pc.embedding_dim + dim_idx];
    } else {
        output_data[gid] = float16_t(0.0);
    }
}
