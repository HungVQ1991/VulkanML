#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Partial_Buffer {
    float partial_data[];
};

layout(std430, set = 0, binding = 1) writeonly buffer Out_Buffer {
    float out_data[];
};

layout(push_constant) uniform Push_Constants {
    uint num_partials;
} pc;

shared float shared_sum[256];

void main() {
    uint tid = gl_LocalInvocationID.x;

    float sum = 0.0f;
    for (uint i = tid; i < pc.num_partials; i += 256u) {
        sum += partial_data[i];
    }
    shared_sum[tid] = sum;
    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            shared_sum[tid] += shared_sum[tid + stride];
        }
        barrier();
    }

    if (tid == 0u) {
        out_data[0] = shared_sum[0];
    }
}
