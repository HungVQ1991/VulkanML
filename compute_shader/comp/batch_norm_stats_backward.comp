#version 450
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif

layout(local_size_x = 256) in;

#ifdef USE_FP16
layout(std430, binding = 0) readonly buffer DOut { float16_t dout_data[]; };
#else
layout(std430, binding = 0) readonly buffer DOut { float dout_data[]; };
#endif
layout(std430, binding = 1) readonly buffer XHat { float x_hat[]; };
layout(std430, binding = 2) writeonly buffer DGamma { float dgamma_data[]; };
layout(std430, binding = 3) writeonly buffer DBeta { float dbeta_data[]; };

layout(push_constant) uniform Constants {
    uint batch_size;
    uint dim;
} pcs;

shared float s_dg[256];
shared float s_db[256];

void main() {
    uint j = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (j >= pcs.dim) return;

    float dgamma_sum = 0.0;
    float dbeta_sum = 0.0;

    for (uint i = tid; i < pcs.batch_size; i += 256u) {
#ifdef USE_FP16
        float dout = float(dout_data[i * pcs.dim + j]);
#else
        float dout = dout_data[i * pcs.dim + j];
#endif
        dgamma_sum += dout * x_hat[i * pcs.dim + j];
        dbeta_sum += dout;
    }

    s_dg[tid] = dgamma_sum;
    s_db[tid] = dbeta_sum;
    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            s_dg[tid] += s_dg[tid + stride];
            s_db[tid] += s_db[tid + stride];
        }
        barrier();
    }

    if (tid == 0u) {
        dgamma_data[j] = s_dg[0];
        dbeta_data[j] = s_db[0];
    }
}
