#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require

#define TILE_M 16
#define TILE_N 16

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer InputBuffer {
    float16_t X[];
};

layout(std430, set = 0, binding = 1) writeonly restrict buffer OutputBuffer {
    float16_t Y[];
};

layout(push_constant) uniform PushConstants {
    uint total_elements;
} pc;

shared float16_t smem_out[TILE_M * TILE_N];

void main() {
    uint lane_id = gl_LocalInvocationID.x;
    uint tile_base = gl_WorkGroupID.x * (TILE_M * TILE_N);

    if (tile_base >= pc.total_elements) return;

    for (uint i = 0; i < 8; ++i) {
        uint idx = lane_id * 8 + i;
        uint global_idx = tile_base + idx;
        if (global_idx < pc.total_elements) {
            float x = float(X[global_idx]);
            float s = 1.0f / (1.0f + exp(-clamp(x, -85.0f, 85.0f)));
            smem_out[idx] = float16_t(s);
        } else {
            smem_out[idx] = float16_t(0.0);
        }
    }
    barrier();

    if (tile_base + (TILE_M * TILE_N) <= pc.total_elements) {
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> res;
        coopMatLoad(res, smem_out, 0, TILE_N, gl_CooperativeMatrixLayoutRowMajor);
        coopMatStore(res, Y, tile_base, TILE_N, gl_CooperativeMatrixLayoutRowMajor);
    } else {
        for (uint i = 0; i < 8; ++i) {
            uint idx = lane_id * 8 + i;
            uint global_idx = tile_base + idx;
            if (global_idx < pc.total_elements) {
                Y[global_idx] = smem_out[idx];
            }
        }
    }
}
