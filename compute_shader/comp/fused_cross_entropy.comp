#version 450
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif

layout(local_size_x = 256) in;

#ifdef USE_FP16
layout(std430, binding = 0) readonly buffer LogitsBuffer { float16_t logits_data[]; };
#else
layout(std430, binding = 0) readonly buffer LogitsBuffer { float logits_data[]; };
#endif
layout(std430, binding = 1) readonly buffer TargetsBuffer { float targets_data[]; };
layout(std430, binding = 2) readonly buffer ValidCountBuffer { uint valid_count_data[]; };
#ifdef USE_FP16
layout(std430, binding = 3) writeonly buffer GradLogitsBuffer { float16_t grad_logits_data[]; };
#else
layout(std430, binding = 3) writeonly buffer GradLogitsBuffer { float grad_logits_data[]; };
#endif
layout(std430, binding = 4) writeonly buffer LossesBuffer { float losses_data[]; };

layout(push_constant) uniform Constants {
    uint seq_len;
    uint vocab_size;
    uint valid_tokens;
    int ignore_index;
    uint compute_grad;
    float label_smoothing;
} pc;

shared float s_reduce[256];

void main() {
    uint s = gl_WorkGroupID.x;
    if (s >= pc.seq_len) return;

    uint tid = gl_LocalInvocationID.x;
    uint V = pc.vocab_size;
    uint row_offset = s * V;

    float thread_max = -1e20;
    for (uint v = tid; v < V; v += gl_WorkGroupSize.x) {
#ifdef USE_FP16
        float val = float(logits_data[row_offset + v]);
#else
        float val = logits_data[row_offset + v];
#endif
        if (!isnan(val) && !isinf(val)) {
            thread_max = max(thread_max, val);
        }
    }
    s_reduce[tid] = thread_max;
    barrier();

    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (tid < stride) {
            s_reduce[tid] = max(s_reduce[tid], s_reduce[tid + stride]);
        }
        barrier();
    }
    float row_max = s_reduce[0];
    barrier();

    float thread_sum = 0.0;
    for (uint v = tid; v < V; v += gl_WorkGroupSize.x) {
#ifdef USE_FP16
        float val = float(logits_data[row_offset + v]);
#else
        float val = logits_data[row_offset + v];
#endif
        if (!isnan(val) && !isinf(val)) {
            thread_sum += exp(val - row_max);
        }
    }
    s_reduce[tid] = thread_sum;
    barrier();

    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (tid < stride) {
            s_reduce[tid] += s_reduce[tid + stride];
        }
        barrier();
    }
    float row_sum = s_reduce[0];
    barrier();

    float smooth_eps = (pc.label_smoothing > 0.0 && pc.label_smoothing < 1.0) ? pc.label_smoothing : 0.0;
    float mean_logit = 0.0;
    if (smooth_eps > 0.0) {
        float thread_logit_sum = 0.0;
        for (uint v = tid; v < V; v += gl_WorkGroupSize.x) {
#ifdef USE_FP16
            float val = float(logits_data[row_offset + v]);
#else
            float val = logits_data[row_offset + v];
#endif
            if (!isnan(val) && !isinf(val)) {
                thread_logit_sum += val;
            }
        }
        s_reduce[tid] = thread_logit_sum;
        barrier();

        for (uint stride = 128; stride > 0; stride >>= 1) {
            if (tid < stride) {
                s_reduce[tid] += s_reduce[tid + stride];
            }
            barrier();
        }
        mean_logit = (V > 0u) ? (s_reduce[0] / float(V)) : 0.0;
        barrier();
    }

    float lse = row_max + log(max(row_sum, 1e-12));
    int target = int(round(targets_data[s]));
    bool is_valid = (target >= 0 && target != pc.ignore_index && uint(target) < V);

    uint eff_valid = (pc.valid_tokens > 0) ? pc.valid_tokens : valid_count_data[0];

    if (tid == 0) {
        if (is_valid) {
#ifdef USE_FP16
            float target_logit = float(logits_data[row_offset + uint(target)]);
#else
            float target_logit = logits_data[row_offset + uint(target)];
#endif
            if (isnan(target_logit) || isinf(target_logit) || row_sum <= 0.0 || isnan(row_sum) || isinf(row_sum)) {
                losses_data[s] = uintBitsToFloat(0x7fc00000u);
            } else if (smooth_eps > 0.0) {
                losses_data[s] = (1.0 - smooth_eps) * (lse - target_logit) + smooth_eps * (lse - mean_logit);
            } else {
                losses_data[s] = lse - target_logit;
            }
        } else {
            losses_data[s] = 0.0;
        }
        if (s == 0) {
            losses_data[pc.seq_len] = float(eff_valid);
        }
    }

    if (pc.compute_grad == 0u) return;

    float inv_sum = (row_sum > 0.0) ? (1.0 / row_sum) : 0.0;
    float scale = (eff_valid > 0) ? (1.0 / float(eff_valid)) : 0.0;
    float uniform_q = (smooth_eps > 0.0 && V > 0u) ? (smooth_eps / float(V)) : 0.0;

    for (uint v = tid; v < V; v += gl_WorkGroupSize.x) {
        uint idx = row_offset + v;
        if (is_valid) {
#ifdef USE_FP16
            float logit_val = float(logits_data[idx]);
#else
            float logit_val = logits_data[idx];
#endif
            float prob = 0.0;
            if (!isnan(logit_val) && !isinf(logit_val)) {
                prob = exp(logit_val - row_max) * inv_sum;
            }
            float q_target = (smooth_eps > 0.0)
                ? (((v == uint(target)) ? (1.0 - smooth_eps) : 0.0) + uniform_q)
                : ((v == uint(target)) ? 1.0 : 0.0);
#ifdef USE_FP16
            float g = (prob - q_target) * scale;
            if (isnan(g) || isinf(g)) g = 0.0;
            grad_logits_data[idx] = float16_t(clamp(g, -65504.0, 65504.0));
#else
            grad_logits_data[idx] = (prob - q_target) * scale;
#endif
        } else {
#ifdef USE_FP16
            grad_logits_data[idx] = float16_t(0.0);
#else
            grad_logits_data[idx] = 0.0;
#endif
        }
    }
}
