#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer InBuffer { float in_data[]; };
layout(std430, binding = 1) writeonly buffer OutBuffer { float out_data[]; };

layout(push_constant) uniform Constants {
    uint total_pairs;
    uint seq_len;
    uint head_dim;
    int direction;
    float base;
    uint num_heads;
    uint mode; // 0: standard, 1: fused_permute ([B,S,H,D] -> [B,H,S,D]), 2: fused_unpermute ([B,H,S,D] -> [B,S,H,D])
} pcs;

void main() {
    uint pair_id = gl_GlobalInvocationID.x;
    if (pair_id >= pcs.total_pairs) return;

    uint base_idx = pair_id * 2;
    uint D = pcs.head_dim;
    uint S = pcs.seq_len;
    uint H = pcs.num_heads;

    uint c = base_idx % D;
    uint pair_idx = c / 2;
    uint token_pos;
    uint in_idx;
    uint out_idx;

    if (pcs.mode == 1) {
        token_pos = (base_idx / D) % S;
        uint h = (base_idx / (D * S)) % H;
        uint b = base_idx / (D * S * H);
        in_idx = b * (S * H * D) + token_pos * (H * D) + h * D + c;
        out_idx = base_idx;
    } else if (pcs.mode == 2) {
        token_pos = (base_idx / D) % S;
        uint h = (base_idx / (D * S)) % H;
        uint b = base_idx / (D * S * H);
        in_idx = base_idx;
        out_idx = b * (S * H * D) + token_pos * (H * D) + h * D + c;
    } else {
        token_pos = (base_idx / D) % S;
        in_idx = base_idx;
        out_idx = base_idx;
    }

    float theta = pow(pcs.base, -2.0 * float(pair_idx) / float(D));
    float alpha = float(pcs.direction) * float(token_pos) * theta;
    float cos_a = cos(alpha);
    float sin_a = sin(alpha);

    float x0 = in_data[in_idx];
    float x1 = in_data[in_idx + 1];

    out_data[out_idx]     = x0 * cos_a - x1 * sin_a;
    out_data[out_idx + 1] = x0 * sin_a + x1 * cos_a;
}
