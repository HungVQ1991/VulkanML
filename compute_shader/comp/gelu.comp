#version 450
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif

layout(local_size_x = 256) in;

#ifdef USE_FP16
layout(set = 0, binding = 0) readonly buffer Input_Buffer { float16_t input_data[]; };
layout(set = 0, binding = 1) writeonly buffer Output_Buffer { float16_t output_data[]; };
#else
layout(set = 0, binding = 0) readonly buffer Input_Buffer { float input_data[]; };
layout(set = 0, binding = 1) writeonly buffer Output_Buffer { float output_data[]; };
#endif

layout(push_constant) uniform Push_Constants { uint num_elements; };

void main() {
    uint idx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (idx >= num_elements) return;

#ifdef USE_FP16
    float x = float(input_data[idx]);
#else
    float x = input_data[idx];
#endif
    float k = 0.79788456f;
    float y = clamp(k * (x + 0.044715f * x * x * x), -15.0f, 15.0f);

#ifdef USE_FP16
    output_data[idx] = float16_t(0.5f * x * (1.0f + tanh(y)));
#else
    output_data[idx] = 0.5f * x * (1.0f + tanh(y));
#endif
}
