#version 450
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif

layout(local_size_x = 256) in;

#ifdef USE_FP16
layout(std430, binding = 0) readonly buffer InData { float16_t data[]; };
#else
layout(std430, binding = 0) readonly buffer InData { float data[]; };
#endif
layout(std430, binding = 1) writeonly buffer BatchMean { float batch_mean[]; };
layout(std430, binding = 2) writeonly buffer BatchVar { float batch_var[]; };
layout(std430, binding = 3) buffer RunningMean { float running_mean[]; };
layout(std430, binding = 4) buffer RunningVar { float running_var[]; };

layout(push_constant) uniform Constants {
    uint batch_size;
    uint dim;
    float momentum;
} pcs;

shared float s_sum[256];
shared float s_mean;

void main() {
    uint j = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (j >= pcs.dim) return;
    if (pcs.batch_size == 0u) {
        if (tid == 0u) {
            batch_mean[j] = 0.0;
            batch_var[j] = 0.0;
        }
        return;
    }

    float local_sum = 0.0;
    for (uint i = tid; i < pcs.batch_size; i += 256u) {
#ifdef USE_FP16
        local_sum += float(data[i * pcs.dim + j]);
#else
        local_sum += data[i * pcs.dim + j];
#endif
    }
    s_sum[tid] = local_sum;
    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            s_sum[tid] += s_sum[tid + stride];
        }
        barrier();
    }

    if (tid == 0u) {
        s_mean = s_sum[0] / float(pcs.batch_size);
    }
    barrier();

    float mean = s_mean;
    float local_var = 0.0;
    for (uint i = tid; i < pcs.batch_size; i += 256u) {
#ifdef USE_FP16
        float diff = float(data[i * pcs.dim + j]) - mean;
#else
        float diff = data[i * pcs.dim + j] - mean;
#endif
        local_var += diff * diff;
    }
    s_sum[tid] = local_var;
    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            s_sum[tid] += s_sum[tid + stride];
        }
        barrier();
    }

    if (tid == 0u) {
        float variance = s_sum[0] / float(pcs.batch_size);
        batch_mean[j] = mean;
        batch_var[j] = variance;
        running_mean[j] = (1.0 - pcs.momentum) * running_mean[j] + pcs.momentum * mean;
        running_var[j] = (1.0 - pcs.momentum) * running_var[j] + pcs.momentum * variance;
    }
}
