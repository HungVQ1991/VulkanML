#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InBuffer     { float16_t in_data[]; };
layout(std430, binding = 0) readonly buffer InBuffer4    { f16vec4   in_data4[]; };
layout(std430, binding = 1) readonly buffer GammaBuffer  { float16_t gamma_data[]; };
layout(std430, binding = 1) readonly buffer GammaBuffer4 { f16vec4   gamma4[]; };
layout(std430, binding = 2) writeonly buffer OutBuffer   { float16_t out_data[]; };
layout(std430, binding = 2) writeonly buffer OutBuffer4  { f16vec4   out_data4[]; };
layout(std430, binding = 3) writeonly buffer InvRmsBuffer { float inv_rms_data[]; };

layout(push_constant) uniform Constants {
    uint batch_size;
    uint dim;
    float epsilon;
} pcs;

shared float s_wave_sums[16];

float blockReduceSum(float val) {
    val = subgroupAdd(val);
    if (gl_SubgroupInvocationID == 0u) {
        s_wave_sums[gl_SubgroupID] = val;
    }
    barrier();
    float total = 0.0;
    for (uint i = 0u; i < gl_NumSubgroups; ++i) {
        total += s_wave_sums[i];
    }
    return total;
}

void main() {
    uint dim = pcs.dim;
    if (dim == 0u || pcs.batch_size == 0u) return;
    uint row = gl_WorkGroupID.x;
    if (row >= pcs.batch_size) return;

    uint lid = gl_LocalInvocationID.x;

    if (dim <= 256u && (dim & 3u) == 0u) {
        uint vec_count = dim >> 2u;
        uint rbase4 = row * vec_count;
        vec4 x = vec4(0.0);
        vec4 g = vec4(0.0);
        float sum_sq = 0.0;

        if (lid < vec_count) {
            uint vidx = rbase4 + lid;
            x = vec4(in_data4[vidx]);
            g = vec4(gamma4[lid]);
            sum_sq = dot(x, x);
        }

        float mean_sq = blockReduceSum(sum_sq) / float(dim);
        float inv_rms = inversesqrt(mean_sq + pcs.epsilon);
        if (lid == 0u) {
            inv_rms_data[row] = inv_rms;
        }

        if (lid < vec_count) {
            uint vidx = rbase4 + lid;
            out_data4[vidx] = f16vec4(clamp(x * inv_rms * g, vec4(-65504.0), vec4(65504.0)));
        }
    } else if (dim <= 256u) {
        uint row_offset = row * dim;
        float x0 = 0.0, x1 = 0.0, x2 = 0.0, x3 = 0.0;
        float g0 = 0.0, g1 = 0.0, g2 = 0.0, g3 = 0.0;
        float sum_sq = 0.0;

        uint c0 = lid;
        uint c1 = lid + 64u;
        uint c2 = lid + 128u;
        uint c3 = lid + 192u;

        if (c0 < dim) { x0 = float(in_data[row_offset + c0]); g0 = float(gamma_data[c0]); sum_sq = fma(x0, x0, sum_sq); }
        if (c1 < dim) { x1 = float(in_data[row_offset + c1]); g1 = float(gamma_data[c1]); sum_sq = fma(x1, x1, sum_sq); }
        if (c2 < dim) { x2 = float(in_data[row_offset + c2]); g2 = float(gamma_data[c2]); sum_sq = fma(x2, x2, sum_sq); }
        if (c3 < dim) { x3 = float(in_data[row_offset + c3]); g3 = float(gamma_data[c3]); sum_sq = fma(x3, x3, sum_sq); }

        float mean_sq = blockReduceSum(sum_sq) / float(dim);
        float inv_rms = inversesqrt(mean_sq + pcs.epsilon);
        if (lid == 0u) inv_rms_data[row] = inv_rms;

        if (c0 < dim) out_data[row_offset + c0] = float16_t(clamp(x0 * inv_rms * g0, -65504.0, 65504.0));
        if (c1 < dim) out_data[row_offset + c1] = float16_t(clamp(x1 * inv_rms * g1, -65504.0, 65504.0));
        if (c2 < dim) out_data[row_offset + c2] = float16_t(clamp(x2 * inv_rms * g2, -65504.0, 65504.0));
        if (c3 < dim) out_data[row_offset + c3] = float16_t(clamp(x3 * inv_rms * g3, -65504.0, 65504.0));
    } else {
        uint row_offset = row * dim;
        float sum_sq = 0.0;
        for (uint c = lid; c < dim; c += 64u) {
            float val = float(in_data[row_offset + c]);
            sum_sq = fma(val, val, sum_sq);
        }

        float mean_sq = blockReduceSum(sum_sq) / float(dim);
        float inv_rms = inversesqrt(mean_sq + pcs.epsilon);
        if (lid == 0u) {
            inv_rms_data[row] = inv_rms;
        }

        for (uint c = lid; c < dim; c += 64u) {
            out_data[row_offset + c] = float16_t(clamp(float(in_data[row_offset + c]) * inv_rms * float(gamma_data[c]), -65504.0, 65504.0));
        }
    }
}
