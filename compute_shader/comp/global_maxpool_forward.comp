#version 450
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#ifdef USE_FP16
layout(set = 0, binding = 0) readonly buffer Input_Buffer { float16_t input_data[]; };
layout(set = 0, binding = 1) writeonly buffer Output_Buffer { float16_t output_data[]; };
#else
layout(set = 0, binding = 0) readonly buffer Input_Buffer { float input_data[]; };
layout(set = 0, binding = 1) writeonly buffer Output_Buffer { float output_data[]; };
#endif
layout(set = 0, binding = 2) writeonly buffer Mask_Buffer { float mask_data[]; };

layout(push_constant) uniform Push_Constants {
    uint batch_size;
    uint in_h;
    uint in_w;
    uint channels;
} params;

void main() {
    uint c_idx = gl_GlobalInvocationID.x;
    uint n_idx = gl_GlobalInvocationID.y;

    if (c_idx >= params.channels || n_idx >= params.batch_size) {
        return;
    }

    bool has_valid = false;
    float best_val = 0.0;
    float best_spatial = -1.0;
    uint spatial_total = params.in_h * params.in_w;

    for (uint s = 0u; s < spatial_total; ++s) {
        uint in_idx = (n_idx * spatial_total + s) * params.channels + c_idx;
#ifdef USE_FP16
        float val = float(input_data[in_idx]);
#else
        float val = input_data[in_idx];
#endif
        if (!isnan(val) && (!has_valid || val > best_val)) {
            best_val = val;
            best_spatial = float(s);
            has_valid = true;
        }
    }

    uint out_idx = n_idx * params.channels + c_idx;
#ifdef USE_FP16
    output_data[out_idx] = float16_t(best_val);
#else
    output_data[out_idx] = best_val;
#endif
    mask_data[out_idx] = best_spatial;
}
