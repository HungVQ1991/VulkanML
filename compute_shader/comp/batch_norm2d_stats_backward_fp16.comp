#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer GradOutput { float16_t dY[]; };
layout(std430, binding = 1) readonly buffer XHat { float x_hat[]; };
layout(std430, binding = 2) writeonly buffer GradGamma { float dgamma[]; };
layout(std430, binding = 3) writeonly buffer GradBeta { float dbeta[]; };

layout(push_constant) uniform PushConstants {
    uint total_elements;
    uint channels;
    uint spatial_count;
} pc;

shared float shared_dg[256];
shared float shared_db[256];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint C = pc.channels;
    uint total_elements = pc.total_elements;

    uint P_STEP = 256 / C;
    if (P_STEP == 0) P_STEP = 1;
    uint BLOCK = P_STEP * C;

    if (tid < BLOCK) {
        float dg = 0.0;
        float db = 0.0;
        for (uint base = 0; base < total_elements; base += BLOCK) {
            uint idx = base + tid;
            if (idx < total_elements) {
                float dy = float(dY[idx]);
                dg += dy * x_hat[idx];
                db += dy;
            }
        }
        shared_dg[tid] = dg;
        shared_db[tid] = db;
    }
    barrier();

    if (tid < C) {
        float tot_dg = 0.0;
        float tot_db = 0.0;
        for (uint p = 0; p < P_STEP; ++p) {
            tot_dg += shared_dg[tid + p * C];
            tot_db += shared_db[tid + p * C];
        }
        dgamma[tid] = tot_dg;
        dbeta[tid] = tot_db;
    }
}
