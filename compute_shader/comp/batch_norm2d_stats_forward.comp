#version 450
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#ifdef USE_FP16
layout(std430, binding = 0) readonly buffer InputX { float16_t X[]; };
#else
layout(std430, binding = 0) readonly buffer InputX { float X[]; };
#endif
layout(std430, binding = 1) writeonly buffer BatchMean { float batch_mean[]; };
layout(std430, binding = 2) writeonly buffer BatchVar { float batch_var[]; };
layout(std430, binding = 3) buffer RunningMean { float running_mean[]; };
layout(std430, binding = 4) buffer RunningVar { float running_var[]; };

layout(push_constant) uniform PushConstants {
    uint total_elements;
    uint channels;
    uint spatial_count;
    float momentum;
} pc;

shared float shared_buf[256];
shared float shared_mean;

void main() {
    uint c = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint C = pc.channels;
    uint M = pc.spatial_count;
    if (c >= C || M == 0u || pc.total_elements == 0u) return;

    float sum = 0.0;
    for (uint m = tid; m < M; m += 256u) {
#ifdef USE_FP16
        sum += float(X[m * C + c]);
#else
        sum += X[m * C + c];
#endif
    }
    shared_buf[tid] = sum;
    barrier();

    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) {
            shared_buf[tid] += shared_buf[tid + s];
        }
        barrier();
    }

    if (tid == 0u) {
        shared_mean = shared_buf[0] / float(M);
    }
    barrier();

    float mean_val = shared_mean;
    float sq = 0.0;
    for (uint m = tid; m < M; m += 256u) {
#ifdef USE_FP16
        float diff = float(X[m * C + c]) - mean_val;
#else
        float diff = X[m * C + c] - mean_val;
#endif
        sq += diff * diff;
    }
    shared_buf[tid] = sq;
    barrier();

    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) {
            shared_buf[tid] += shared_buf[tid + s];
        }
        barrier();
    }

    if (tid == 0u) {
        float var_val = shared_buf[0] / float(M);
        bool valid_stats = !isnan(mean_val) && !isinf(mean_val) && !isnan(var_val) && !isinf(var_val) && (var_val >= 0.0);
        if (valid_stats) {
            var_val = min(var_val, 1e5);
            float cur_rm = running_mean[c];
            float cur_rv = running_var[c];
            if (isnan(cur_rm) || isinf(cur_rm)) cur_rm = 0.0;
            if (isnan(cur_rv) || isinf(cur_rv) || cur_rv < 0.0) cur_rv = 1.0;
            running_mean[c] = (1.0 - pc.momentum) * cur_rm + pc.momentum * mean_val;
            running_var[c]  = (1.0 - pc.momentum) * cur_rv  + pc.momentum * var_val;
            batch_mean[c] = mean_val;
            batch_var[c] = var_val;
        } else {
            float rm = running_mean[c];
            float rv = running_var[c];
            if (isnan(rm) || isinf(rm)) rm = 0.0;
            if (isnan(rv) || isinf(rv) || rv < 0.0) rv = 1.0;
            batch_mean[c] = rm;
            batch_var[c] = rv;
        }
    }
}
