#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputX { float16_t X[]; };
layout(std430, binding = 1) writeonly buffer BatchMean { float batch_mean[]; };
layout(std430, binding = 2) writeonly buffer BatchVar { float batch_var[]; };
layout(std430, binding = 3) buffer RunningMean { float running_mean[]; };
layout(std430, binding = 4) buffer RunningVar { float running_var[]; };

layout(push_constant) uniform PushConstants {
    uint total_elements;
    uint channels;
    uint spatial_count;
    float momentum;
} pc;

shared float shared_sum[256];
shared float shared_mean[256];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint C = pc.channels;
    uint M = pc.spatial_count;
    uint total_elements = pc.total_elements;

    uint P_STEP = 256 / C;
    if (P_STEP == 0) P_STEP = 1;
    uint BLOCK = P_STEP * C;

    // Pass 1: compute mean with 100% coalesced memory access
    if (tid < BLOCK) {
        float sum = 0.0;
        for (uint base = 0; base < total_elements; base += BLOCK) {
            uint idx = base + tid;
            if (idx < total_elements) {
                sum += float(X[idx]);
            }
        }
        shared_sum[tid] = sum;
    }
    barrier();

    if (tid < C) {
        float tot_sum = 0.0;
        for (uint p = 0; p < P_STEP; ++p) {
            tot_sum += shared_sum[tid + p * C];
        }
        shared_mean[tid] = tot_sum / float(M);
    }
    barrier();

    float mean_c = shared_mean[tid % C];

    // Pass 2: compute variance (hits L2 cache, mathematically stable diff*diff)
    if (tid < BLOCK) {
        float sq = 0.0;
        for (uint base = 0; base < total_elements; base += BLOCK) {
            uint idx = base + tid;
            if (idx < total_elements) {
                float diff = float(X[idx]) - mean_c;
                sq += diff * diff;
            }
        }
        shared_sum[tid] = sq;
    }
    barrier();

    if (tid < C) {
        float tot_sq = 0.0;
        for (uint p = 0; p < P_STEP; ++p) {
            tot_sq += shared_sum[tid + p * C];
        }
        float var_val = tot_sq / float(M);
        float mean_val = shared_mean[tid];

        batch_mean[tid] = mean_val;
        batch_var[tid] = var_val;

        // Update running stats in-place
        running_mean[tid] = pc.momentum * running_mean[tid] + (1.0 - pc.momentum) * mean_val;
        running_var[tid]  = pc.momentum * running_var[tid]  + (1.0 - pc.momentum) * var_val;
    }
}
