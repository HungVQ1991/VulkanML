#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) writeonly buffer Output_Buffer {
    float out_data[];
};

layout(push_constant) uniform PushConstants {
    uint total_elements;
    float fill_value;
} pc;

void main() {
    uint idx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    if (idx >= pc.total_elements) return;
    out_data[idx] = pc.fill_value;
}
