#version 450
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif

layout(local_size_x = 256) in;

#ifdef USE_FP16
layout(std430, binding = 0) readonly buffer QBuffer { float16_t q_data[]; };
layout(std430, binding = 1) readonly buffer KBuffer { float16_t k_data[]; };
layout(std430, binding = 2) readonly buffer VBuffer { float16_t v_data[]; };
layout(std430, binding = 3) writeonly buffer OutBuffer { float16_t out_data[]; };
#else
layout(std430, binding = 0) readonly buffer QBuffer { float q_data[]; };
layout(std430, binding = 1) readonly buffer KBuffer { float k_data[]; };
layout(std430, binding = 2) readonly buffer VBuffer { float v_data[]; };
layout(std430, binding = 3) writeonly buffer OutBuffer { float out_data[]; };
#endif

layout(push_constant) uniform Constants {
    uint num_heads;
    uint head_dim;
    uint total_seq_len;
    float scale;
    uint gqa_group_size;
} pc;

shared float s_reduce[256];

void main() {
    uint h = gl_WorkGroupID.x;
    if (h >= pc.num_heads) return;

    uint kv_h = h / max(pc.gqa_group_size, 1u);
    uint tid = gl_LocalInvocationID.x;
    uint d = pc.head_dim;
    uint T = pc.total_seq_len;

    for (uint d_base = 0; d_base < d; d_base += 256) {
        uint out_d = d_base + tid;

        float m = -1e20;
        float l = 0.0;
        float o = 0.0;

        for (uint t = 0; t < T; ++t) {
            float partial_dot = 0.0;
            for (uint j = tid; j < d; j += 256) {
#ifdef USE_FP16
                partial_dot += float(q_data[h * d + j]) * float(k_data[kv_h * T * d + t * d + j]);
#else
                partial_dot += q_data[h * d + j] * k_data[kv_h * T * d + t * d + j];
#endif
            }
            s_reduce[tid] = partial_dot;
            barrier();

            for (uint s = 128; s > 0; s >>= 1) {
                if (tid < s) {
                    s_reduce[tid] += s_reduce[tid + s];
                }
                barrier();
            }

            float dot_prod = s_reduce[0];
            barrier();

            float s_t = dot_prod * pc.scale;
#ifdef USE_FP16
            float v_val = (out_d < d) ? float(v_data[kv_h * T * d + t * d + out_d]) : 0.0;
#else
            float v_val = (out_d < d) ? v_data[kv_h * T * d + t * d + out_d] : 0.0;
#endif

            float m_new = max(m, s_t);
            float alpha = exp(m - m_new);
            float beta = exp(s_t - m_new);

            l = l * alpha + beta;
            o = o * alpha + beta * v_val;
            m = m_new;
        }

        if (out_d < d) {
            float inv_l = (l > 0.0) ? (1.0 / l) : 0.0;
#ifdef USE_FP16
            out_data[h * d + out_d] = float16_t(o * inv_l);
#else
            out_data[h * d + out_d] = o * inv_l;
#endif
        }
    }
}
