#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer GradY     { float16_t data_dy[]; };
layout(std430, binding = 0) readonly buffer GradY4    { f16vec4   data_dy4[]; };
layout(std430, binding = 0) readonly buffer GradY8    { uvec4     data_dy8[]; };
layout(std430, binding = 1) readonly buffer InMatrix  { float16_t data_in[]; };
layout(std430, binding = 1) readonly buffer InMatrix4 { f16vec4   data_in4[]; };
layout(std430, binding = 1) readonly buffer InMatrix8 { uvec4     data_in8[]; };
layout(std430, binding = 2) writeonly buffer GradX    { float16_t data_dx[]; };
layout(std430, binding = 2) writeonly buffer GradX4   { f16vec4   data_dx4[]; };
layout(std430, binding = 2) writeonly buffer GradX8   { uvec4     data_dx8[]; };

layout(push_constant) uniform Constants {
    uint total_elements;
    uint half_dim;
} pcs;

const float NEG_LOG2E = -1.44269504;

vec4 sanitizeFiniteVec4(vec4 v) {
    return mix(vec4(0.0), v, lessThanEqual(abs(v), vec4(3.4e38)));
}

void evalSwigluBwdVec4(vec4 dy, vec4 a, vec4 b, out vec4 da, out vec4 db) {
    dy = sanitizeFiniteVec4(dy);
    a  = sanitizeFiniteVec4(a);
    b  = sanitizeFiniteVec4(b);

    vec4 sig_a    = vec4(1.0) / (vec4(1.0) + exp2(clamp(a, vec4(-85.0), vec4(85.0)) * NEG_LOG2E));
    vec4 silu_a   = a * sig_a;
    vec4 d_silu_a = sig_a * fma(a, vec4(1.0) - sig_a, vec4(1.0));

    db = clamp(sanitizeFiniteVec4(dy * silu_a),     vec4(-65504.0), vec4(65504.0));
    da = clamp(sanitizeFiniteVec4(dy * b * d_silu_a), vec4(-65504.0), vec4(65504.0));
}

uvec4 pack8Fp16(vec4 lo, vec4 hi) {
    return uvec4(
        packHalf2x16(lo.xy),
        packHalf2x16(lo.zw),
        packHalf2x16(hi.xy),
        packHalf2x16(hi.zw)
    );
}

void main() {
    if (pcs.half_dim == 0u) return;
    uint wg_id = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint tid = wg_id * 256u + gl_LocalInvocationID.x;

    if ((pcs.half_dim & 7u) == 0u) {
        uint total_v8 = pcs.total_elements >> 3u;
        if (tid >= total_v8) return;

        uint half_dim8 = pcs.half_dim >> 3u;
        uint row;
        uint col8;
        if (bitCount(half_dim8) == 1) {
            int sh = findLSB(half_dim8);
            row  = tid >> sh;
            col8 = tid & (half_dim8 - 1u);
        } else {
            row  = tid / half_dim8;
            col8 = tid % half_dim8;
        }
        uint in_base8 = row * (half_dim8 << 1u) + col8;

        uvec4 dy_u = data_dy8[tid];
        uvec4 a_u  = data_in8[in_base8];
        uvec4 b_u  = data_in8[in_base8 + half_dim8];

        vec4 da0, db0, da1, db1;
        evalSwigluBwdVec4(
            vec4(unpackHalf2x16(dy_u.x), unpackHalf2x16(dy_u.y)),
            vec4(unpackHalf2x16(a_u.x),  unpackHalf2x16(a_u.y)),
            vec4(unpackHalf2x16(b_u.x),  unpackHalf2x16(b_u.y)),
            da0, db0);
        evalSwigluBwdVec4(
            vec4(unpackHalf2x16(dy_u.z), unpackHalf2x16(dy_u.w)),
            vec4(unpackHalf2x16(a_u.z),  unpackHalf2x16(a_u.w)),
            vec4(unpackHalf2x16(b_u.z),  unpackHalf2x16(b_u.w)),
            da1, db1);

        data_dx8[in_base8]             = pack8Fp16(da0, da1);
        data_dx8[in_base8 + half_dim8] = pack8Fp16(db0, db1);
    } else if ((pcs.half_dim & 3u) == 0u) {
        uint total_vecs = pcs.total_elements >> 2u;
        if (tid >= total_vecs) return;

        uint half_dim4 = pcs.half_dim >> 2u;
        uint row = tid / half_dim4;
        uint col4 = tid % half_dim4;
        uint in_base4 = row * (half_dim4 * 2u) + col4;

        vec4 da, db;
        evalSwigluBwdVec4(vec4(data_dy4[tid]), vec4(data_in4[in_base4]), vec4(data_in4[in_base4 + half_dim4]), da, db);

        data_dx4[in_base4]             = f16vec4(da);
        data_dx4[in_base4 + half_dim4] = f16vec4(db);
    } else {
        if (tid >= pcs.total_elements) return;
        uint row = tid / pcs.half_dim;
        uint col = tid % pcs.half_dim;
        uint in_base = row * (pcs.half_dim * 2u) + col;

        float dy = float(data_dy[tid]);
        float a  = float(data_in[in_base]);
        float b  = float(data_in[in_base + pcs.half_dim]);
        if (isnan(dy) || isinf(dy)) dy = 0.0;
        if (isnan(a)  || isinf(a))  a  = 0.0;
        if (isnan(b)  || isinf(b))  b  = 0.0;

        float sig_a = 1.0 / (1.0 + exp2(clamp(a, -85.0, 85.0) * NEG_LOG2E));
        float silu_a = a * sig_a;
        float d_silu_a = sig_a * fma(a, 1.0 - sig_a, 1.0);

        float db_val = dy * silu_a;
        float da_val = dy * b * d_silu_a;
        if (isnan(db_val) || isinf(db_val)) db_val = 0.0;
        if (isnan(da_val) || isinf(da_val)) da_val = 0.0;

        data_dx[in_base]                = float16_t(clamp(da_val, -65504.0, 65504.0));
        data_dx[in_base + pcs.half_dim] = float16_t(clamp(db_val, -65504.0, 65504.0));
    }
}
