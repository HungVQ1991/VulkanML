#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer GradY  { float16_t data_dy[]; };
layout(std430, binding = 0) readonly buffer GradY4 { f16vec4   data_dy4[]; };
layout(std430, binding = 1) readonly buffer InA    { float16_t data_a[]; };
layout(std430, binding = 1) readonly buffer InA4   { f16vec4   data_a4[]; };
layout(std430, binding = 2) readonly buffer InB    { float16_t data_b[]; };
layout(std430, binding = 2) readonly buffer InB4   { f16vec4   data_b4[]; };
layout(std430, binding = 3) writeonly buffer GradA { float16_t data_da[]; };
layout(std430, binding = 3) writeonly buffer GradA4{ f16vec4   data_da4[]; };
layout(std430, binding = 4) writeonly buffer GradB { float16_t data_db[]; };
layout(std430, binding = 4) writeonly buffer GradB4{ f16vec4   data_db4[]; };

layout(push_constant) uniform Constants {
    uint total_elements;
} pcs;

const float NEG_LOG2E = -1.44269504;

void main() {
    uint wg_id = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint vec_idx = wg_id * 256u + gl_LocalInvocationID.x;
    uint base = vec_idx * 4u;
    if (base >= pcs.total_elements) return;

    if (base + 3u < pcs.total_elements) {
        vec4 dy = vec4(data_dy4[vec_idx]);
        vec4 a  = vec4(data_a4[vec_idx]);
        vec4 b  = vec4(data_b4[vec_idx]);

        vec4 sig    = vec4(1.0) / (vec4(1.0) + exp2(clamp(a, vec4(-85.0), vec4(85.0)) * NEG_LOG2E));
        vec4 silu   = a * sig;
        vec4 d_silu = sig * fma(a, vec4(1.0) - sig, vec4(1.0));

        vec4 db = clamp(dy * silu, vec4(-65504.0), vec4(65504.0));
        vec4 da = clamp(dy * b * d_silu, vec4(-65504.0), vec4(65504.0));

        data_db4[vec_idx] = f16vec4(db);
        data_da4[vec_idx] = f16vec4(da);
    } else {
        for (uint k = 0u; k < 4u && base + k < pcs.total_elements; ++k) {
            uint idx = base + k;
            float dy = float(data_dy[idx]);
            float a  = float(data_a[idx]);
            float b  = float(data_b[idx]);

            float sig_a = 1.0 / (1.0 + exp2(clamp(a, -85.0, 85.0) * NEG_LOG2E));
            float silu_a = a * sig_a;
            float d_silu_a = sig_a * fma(a, 1.0 - sig_a, 1.0);

            data_db[idx] = float16_t(clamp(dy * silu_a, -65504.0, 65504.0));
            data_da[idx] = float16_t(clamp(dy * b * d_silu_a, -65504.0, 65504.0));
        }
    }
}
