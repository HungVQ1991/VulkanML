#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require

#define TILE_M 16
#define TILE_N 16

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Pred_Buffer {
    float16_t pred_data[];
};

layout(std430, set = 0, binding = 1) readonly buffer Target_Buffer {
    float16_t target_data[];
};

layout(std430, set = 0, binding = 2) writeonly buffer Grad_Buffer {
    float16_t grad_data[];
};

layout(std430, set = 0, binding = 3) readonly buffer Stats_Buffer {
    float stats_data[];
};

layout(push_constant) uniform Push_Constants {
    uint total_elements;
    float dice_weight;
    float bce_weight;
    float epsilon;
} pc;

shared float16_t smem_out[TILE_M * TILE_N];

void main() {
    uint lane_id = gl_LocalInvocationID.x;
    uint tile_base = gl_WorkGroupID.x * (TILE_M * TILE_N);

    if (tile_base >= pc.total_elements) return;

    float total_inter = stats_data[1];
    float total_pred = stats_data[2];
    float total_target = stats_data[3];

    float denom = max(total_pred + total_target + pc.epsilon, 1e-4f);
    float numer = 2.0f * total_inter + pc.epsilon;
    float inv_N = 1.0f / float(pc.total_elements);

    for (uint i = 0; i < 8; ++i) {
        uint idx = lane_id * 8 + i;
        uint global_idx = tile_base + idx;
        if (global_idx < pc.total_elements) {
            float p = clamp(float(pred_data[global_idx]), pc.epsilon, 1.0f - pc.epsilon);
            float y = float(target_data[global_idx]);

            float dice_grad = (numer - 2.0f * y * denom) / (denom * denom);
            float p_safe = clamp(p, 1e-4f, 1.0f - 1e-4f);
            float bce_grad = (p - y) / (p_safe * (1.0f - p_safe)) * inv_N;

            float grad = pc.dice_weight * dice_grad + pc.bce_weight * bce_grad;
            if (isnan(grad) || isinf(grad)) {
                grad = 0.0f;
            } else {
                grad = clamp(grad, -65504.0f, 65504.0f);
            }
            smem_out[idx] = float16_t(grad);
        } else {
            smem_out[idx] = float16_t(0.0);
        }
    }
    barrier();

    if (tile_base + (TILE_M * TILE_N) <= pc.total_elements) {
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> res;
        coopMatLoad(res, smem_out, 0, TILE_N, gl_CooperativeMatrixLayoutRowMajor);
        coopMatStore(res, grad_data, tile_base, TILE_N, gl_CooperativeMatrixLayoutRowMajor);
    } else {
        for (uint i = 0; i < 8; ++i) {
            uint idx = lane_id * 8 + i;
            uint global_idx = tile_base + idx;
            if (global_idx < pc.total_elements) {
                grad_data[global_idx] = smem_out[idx];
            }
        }
    }
}
